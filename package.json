{
  "name": "groovster",
  "private": true,
  "version": "0.0.0",
  "description": "Era Widgets — CSS-first, spec-first UI skins for agents (working title; never Forma UI).",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "elements:build": "pnpm --filter @groovster/elements build",
    "gen": "pnpm elements:build && pnpm --filter @groovster/gen gen",
    "gen:check": "pnpm --filter @groovster/gen check",
    "validate": "pnpm --filter @groovster/gen validate",
    "smoke": "pnpm gen && echo 'Open demos/smoke/index.html (or serve demos/smoke)'",
    "check": "pnpm validate && pnpm gen:check && pnpm contrast && pnpm no-imports",
    "lint": "eslint .",
    "eval": "pnpm --filter @groovster/eval eval",
    "eval:baseline": "pnpm --filter @groovster/eval baseline",
    "no-imports": "pnpm --filter @groovster/gen exec node src/cli.js no-imports",
    "contrast": "pnpm --filter @groovster/contrast contrast",
    "a11y": "pnpm --filter @groovster/a11y test",
    "a11y:keyboard": "pnpm --filter @groovster/a11y test:keyboard",
    "test:a11y": "pnpm a11y && pnpm a11y:keyboard && pnpm test:unit",
    "mcp": "pnpm --filter @groovster/mcp start",
    "mcp:smoke": "pnpm --filter @groovster/mcp smoke",
    "registry:serve": "python3 -m http.server 4174 --directory registry",
    "test:unit": "node --import tsx --test tests/unit/*.test.mjs",
    "react:typecheck": "pnpm --filter @groovster/react typecheck",
    "registry:e2e": "node scripts/registry-e2e.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "playwright": "^1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2"
  }
}
