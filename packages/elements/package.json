  "files": ["dist", "README.md"],
  "exports": {
    ".": "./dist/era-elements.js",
    "./era-elements.js": "./dist/era-elements.js",
    "./ew-tabs.js": "./dist/ew-tabs.js",
    "./ew-select.js": "./dist/ew-select.js",
    "./ew-menu.js": "./dist/ew-menu.js",
    "./ew-popover.js": "./dist/ew-popover.js",
    "./ew-tooltip.js": "./dist/ew-tooltip.js",
    "./ew-toast.js": "./dist/ew-toast.js",
    "./ew-slider.js": "./dist/ew-slider.js"
  },
  "scripts": {
    "build": "node ../../scripts/bundle-elements.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["era-widgets", "web-components", "a11y", "apg"]
