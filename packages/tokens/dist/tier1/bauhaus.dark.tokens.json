  },
  "radius": {
    "none": {
      "$type": "dimension",
      "$value": "0px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "0px"
    },
    "md": {
      "$type": "dimension",
      "$value": "0px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "0px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
