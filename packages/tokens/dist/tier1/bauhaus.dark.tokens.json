        "$value": "#262626"
      },
      "3": {
        "$type": "color",
        "$value": "#3D3D3D"
      },
      "4": {
        "$type": "color",
        "$value": "#5E5E5A"
      },
      "5": {
        "$type": "color",
        "$value": "#8C877E"
      },
      "6": {
        "$type": "color",
        "$value": "#C8C2B6"
      },
      "7": {
        "$type": "color",
        "$value": "#DDD7CB"
