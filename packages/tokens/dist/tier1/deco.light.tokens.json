{
  "$schema": "../../../schema/tokens.schema.json",
  "meta": {
    "tier": 1,
    "era": "deco",
    "mode": "light",
    "description": "Tier 1 raw values for deco light (ivory, parchment, architectural brass)"
  },
  "color": {
    "ink": {
      "$type": "color",
      "$value": "#171410",
      "$description": "warm charcoal, high contrast on ivory"
    },
    "paper": {
      "$type": "color",
      "$value": "#F3EEE4",
      "$description": "ivory page"
    },
    "panel": {
      "$type": "color",
      "$value": "#F8F4EB",
      "$description": "parchment surface"
    },
    "sky": {
      "$type": "color",
      "$value": "#FBF8F3",
      "$description": "elevated ivory, not pure white"
    },
    "cream": {
      "$type": "color",
      "$value": "#4C453C",
      "$description": "muted text on ivory"
    },
    "gold": {
      "$type": "color",
      "$value": "#B08D2C",
      "$description": "gold borders and accents"
    },
    "brass": {
      "$type": "color",
      "$value": "#9A7820",
      "$description": "darker brass for light-mode contrast (elevated mixes, tracks)"
    },
    "brassDeep": {
      "$type": "color",
      "$value": "#5C4510",
      "$description": "deep brass for terraced elevation on ivory"
    },
    "champagne": {
      "$type": "color",
      "$value": "#C4A35A",
      "$description": "soft metallic accent, not used for small text"
    },
    "goldText": {
      "$type": "color",
      "$value": "#7A5C12",
      "$description": "gold text on ivory, 5.4:1"
    },
    "goldBorder": {
      "$type": "color",
      "$value": "#9A7820",
      "$description": "field border \u2014 darker brass for AA on ivory"
    },
    "goldSubtle": {
      "$type": "color",
      "$value": "#B08D2C",
      "$description": "subtle border"
    },
    "goldFocus": {
      "$type": "color",
      "$value": "#9A7820",
      "$description": "focus ring"
    },
    "jade": {
      "$type": "color",
      "$value": "#0F5C4D",
      "$description": "ornament secondary"
    },
    "accent": {
      "solid": {
        "$type": "color",
        "$value": "#111111",
        "$description": "black button"
      },
      "fg": {
        "$type": "color",
        "$value": "#F2D98A",
        "$description": "gold text on black, 13.5:1"
      }
    },
    "danger": {
      "solid": {
        "$type": "color",
        "$value": "#8E1B1B"
      },
      "fg": {
        "$type": "color",
        "$value": "#FFFFFF"
      }
    }
  },
  "space": {
    "0": {
      "$type": "dimension",
      "$value": "0px"
    },
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "24px"
    },
    "6": {
      "$type": "dimension",
      "$value": "32px"
    },
    "7": {
      "$type": "dimension",
      "$value": "48px"
    },
    "8": {
      "$type": "dimension",
      "$value": "64px"
    }
  },
  "radius": {
    "none": {
      "$type": "dimension",
      "$value": "0px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "0px"
    },
    "md": {
      "$type": "dimension",
      "$value": "0px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "0px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "0px"
    },
    "step": {
      "$type": "dimension",
      "$value": "8px"
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Limelight",
        "Bodoni Moda",
        "serif"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Jost",
        "Futura",
        "system-ui",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Mono",
        "ui-monospace",
        "monospace"
      ]
    }
  }
}
