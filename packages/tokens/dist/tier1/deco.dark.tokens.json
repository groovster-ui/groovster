{
  "$schema": "../../../schema/tokens.schema.json",
  "meta": {
    "tier": 1,
    "era": "deco",
    "mode": "dark",
    "description": "Tier 1 raw values for deco dark (near-black lacquer, champagne, antique brass)"
  },
  "color": {
    "ink": {
      "$type": "color",
      "$value": "#F4EAD8",
      "$description": "warm ivory ink on lacquer"
    },
    "paper": {
      "$type": "color",
      "$value": "#0C0B09",
      "$description": "near-black lacquer"
    },
    "panel": {
      "$type": "color",
      "$value": "#16130F",
      "$description": "lacquer surface"
    },
    "sky": {
      "$type": "color",
      "$value": "#211C16",
      "$description": "charcoal elevated surface"
    },
    "cream": {
      "$type": "color",
      "$value": "#CDB892",
      "$description": "muted champagne text"
    },
    "gold": {
      "$type": "color",
      "$value": "#D4AF37",
      "$description": "primary brass/gold, 9.4:1 with ink text"
    },
    "brass": {
      "$type": "color",
      "$value": "#C4A15A",
      "$description": "antique brass for mixes and tracks"
    },
    "brassDeep": {
      "$type": "color",
      "$value": "#6A5018",
      "$description": "deep brass for terraced elevation"
    },
    "champagne": {
      "$type": "color",
      "$value": "#E6D4AE",
      "$description": "edge highlight and large display metal"
    },
    "goldText": {
      "$type": "color",
      "$value": "#E4C97A",
      "$description": "large gold type and links on lacquer"
    },
    "goldBright": {
      "$type": "color",
      "$value": "#E6D4AE",
      "$description": "champagne highlight, not flat yellow"
    },
    "goldBorder": {
      "$type": "color",
      "$value": "#B8952F",
      "$description": "field border"
    },
    "goldSubtle": {
      "$type": "color",
      "$value": "#8A6F2E",
      "$description": "subtle border"
    },
    "goldFocus": {
      "$type": "color",
      "$value": "#F1D27A",
      "$description": "focus ring"
    },
    "fieldBg": {
      "$type": "color",
      "$value": "#100E0C",
      "$description": "recessed field on lacquer"
    },
    "jade": {
      "$type": "color",
      "$value": "#1F6F5C",
      "$description": "ornament secondary"
    },
    "oxblood": {
      "$type": "color",
      "$value": "#7A1E1E",
      "$description": "danger + ornament tertiary"
    },
    "accent": {
      "solid": {
        "$type": "color",
        "$value": "#D4AF37"
      },
      "fg": {
        "$type": "color",
        "$value": "#0C0B09"
      }
    },
    "danger": {
      "solid": {
        "$type": "color",
        "$value": "#7A1E1E"
      },
      "fg": {
        "$type": "color",
        "$value": "#F3E7C9"
      }
    }
  },
  "space": {
    "0": {
      "$type": "dimension",
      "$value": "0px"
    },
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "24px"
    },
    "6": {
      "$type": "dimension",
      "$value": "32px"
    },
    "7": {
      "$type": "dimension",
      "$value": "48px"
    },
    "8": {
      "$type": "dimension",
      "$value": "64px"
    }
  },
  "radius": {
    "none": {
      "$type": "dimension",
      "$value": "0px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "0px"
    },
    "md": {
      "$type": "dimension",
      "$value": "0px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "0px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "0px"
    },
    "step": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "stepped frame increment"
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Limelight",
        "Bodoni Moda",
        "serif"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Jost",
        "Futura",
        "system-ui",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Mono",
        "ui-monospace",
        "monospace"
      ]
    }
  }
}
