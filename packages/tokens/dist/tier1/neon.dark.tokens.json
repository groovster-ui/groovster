{
  "$schema": "../../../schema/tokens.schema.json",
  "meta": {
    "tier": 1,
    "era": "neon",
    "mode": "dark",
    "description": "Tier 1 raw values for neon dark — indigo night + magenta/cyan"
  },
  "color": {
    "sky": {
      "$type": "color",
      "$value": "#0D0221",
      "$description": "indigo night page"
    },
    "panel": {
      "$type": "color",
      "$value": "#1A0B2E",
      "$description": "surface lacquer"
    },
    "magenta": {
      "$type": "color",
      "$value": "#FF2A6D",
      "$description": "hot neon magenta"
    },
    "cyan": {
      "$type": "color",
      "$value": "#05D9E8",
      "$description": "electric cyan"
    },
    "violet": {
      "$type": "color",
      "$value": "#2D0A4E",
      "$description": "elevated violet"
    },
    "ink": {
      "$type": "color",
      "$value": "#F5F0FF",
      "$description": "near-white text on night"
    },
    "sun": {
      "$type": "color",
      "$value": "#FFC857",
      "$description": "sunset yellow"
    },
    "orange": {
      "$type": "color",
      "$value": "#FF6B35",
      "$description": "sunset orange"
    },
    "accent": {
      "solid": {
        "$type": "color",
        "$value": "#FF2A6D"
      },
      "fg": {
        "$type": "color",
        "$value": "#0D0221"
      }
    },
    "danger": {
      "solid": {
        "$type": "color",
        "$value": "#FF4D4D"
      },
      "fg": {
        "$type": "color",
        "$value": "#0D0221"
      }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "48px" },
    "8": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0px" },
    "sm": { "$type": "dimension", "$value": "0px" },
    "md": { "$type": "dimension", "$value": "2px" },
    "lg": { "$type": "dimension", "$value": "4px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": ["Orbitron", "Eurostile", "sans-serif"]
    },
    "body": {
      "$type": "fontFamily",
      "$value": ["Exo 2", "system-ui", "sans-serif"]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["Share Tech Mono", "ui-monospace", "monospace"]
    },
    "chrome": {
      "$type": "fontFamily",
      "$value": ["Monoton", "Orbitron", "sans-serif"]
    },
    "script": {
      "$type": "fontFamily",
      "$value": ["Mr Dafoe", "Brush Script MT", "cursive"]
    }
  }
}
