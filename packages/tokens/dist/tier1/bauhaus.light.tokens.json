{
  "$schema": "../../../schema/tokens.schema.json",
  "meta": {
    "tier": 1,
    "era": "bauhaus",
    "mode": "light",
    "description": "bauhaus light: original local palette"
  },
  "color": {
    "gray": {
      "0": {
        "$type": "color",
        "$value": "#F4F0E6"
