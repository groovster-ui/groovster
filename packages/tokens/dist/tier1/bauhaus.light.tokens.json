      "1": {
        "$type": "color",
        "$value": "#EBE6DA"
      },
      "2": {
        "$type": "color",
        "$value": "#DDD6C8"
      },
      "3": {
        "$type": "color",
        "$value": "#C9C0B0"
      },
      "4": {
        "$type": "color",
        "$value": "#A39A8C"
      },
      "5": {
        "$type": "color",
        "$value": "#6E675E"
      },
      "6": {
        "$type": "color",
        "$value": "#4E4943"
      },
      "7": {
        "$type": "color",
        "$value": "#2A2724"
      },
      "8": {
        "$type": "color",
        "$value": "#161513"
      },
      "9": {
        "$type": "color",
        "$value": "#0C0B0A"
