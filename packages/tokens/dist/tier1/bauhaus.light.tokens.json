    "accent": {
      "solid": {
        "$type": "color",
        "$value": "#D0121A"
      },
      "fg": {
        "$type": "color",
        "$value": "#FFFFFF"
      }
    },
    "danger": {
      "solid": {
        "$type": "color",
        "$value": "#AB302E"
      },
      "fg": {
        "$type": "color",
        "$value": "#FFFFFF"
      }
    },
    "primary": {
      "red": {
        "$type": "color",
        "$value": "#D0121A"
      },
      "yellow": {
        "$type": "color",
        "$value": "#F5C400"
      },
      "blue": {
        "$type": "color",
        "$value": "#1E45C4"
      }
    }
  },
  "space": {
    "0": {
      "$type": "dimension",
      "$value": "0px"
    },
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "24px"
    },
    "6": {
      "$type": "dimension",
      "$value": "32px"
    },
    "7": {
      "$type": "dimension",
      "$value": "48px"
    },
    "8": {
      "$type": "dimension",
      "$value": "64px"
    }
  },
  "radius": {
    "none": {
      "$type": "dimension",
      "$value": "0px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "0px"
    },
    "md": {
      "$type": "dimension",
      "$value": "0px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "0px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "League Spartan",
        "Arial",
        "sans-serif"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Source Sans 3",
        "Arial",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Source Code Pro",
        "monospace"
      ]
    }
  }
}
