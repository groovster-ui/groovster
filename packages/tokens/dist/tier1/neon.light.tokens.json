{
  "$schema": "../../../schema/tokens.schema.json",
  "meta": {
    "tier": 1,
    "era": "neon",
    "mode": "light",
    "description": "Tier 1 raw values for neon light — Miami dusk pink sky with saturated neon accents"
  },
  "color": {
    "sky": {
      "$type": "color",
      "$value": "#FFD0E4",
      "$description": "Miami dusk pink page (not lavender)"
    },
    "panel": {
      "$type": "color",
      "$value": "#FFE8F2",
      "$description": "blush surface"
    },
    "magenta": {
      "$type": "color",
      "$value": "#8E1248",
      "$description": "saturated magenta, 4.5:1 on dusk pink"
    },
    "cyan": {
      "$type": "color",
      "$value": "#066A80",
      "$description": "deep cyan for AA on dusk pink"
    },
    "violet": {
      "$type": "color",
      "$value": "#9B4F8A",
      "$description": "dusk rose-violet"
    },
    "ink": {
      "$type": "color",
      "$value": "#1A0A2E",
      "$description": "deep indigo text"
    },
    "sun": {
      "$type": "color",
      "$value": "#E89B20",
      "$description": "dusk sun yellow"
    },
    "orange": {
      "$type": "color",
      "$value": "#E85A2A",
      "$description": "dusk orange"
    },
    "accent": {
      "solid": {
        "$type": "color",
        "$value": "#8E1248"
      },
      "fg": {
        "$type": "color",
        "$value": "#FFFFFF"
      }
    },
    "danger": {
      "solid": {
        "$type": "color",
        "$value": "#C62828"
      },
      "fg": {
        "$type": "color",
        "$value": "#FFFFFF"
      }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "48px" },
    "8": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0px" },
    "sm": { "$type": "dimension", "$value": "0px" },
    "md": { "$type": "dimension", "$value": "2px" },
    "lg": { "$type": "dimension", "$value": "4px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": ["Orbitron", "Eurostile", "sans-serif"]
    },
    "body": {
      "$type": "fontFamily",
      "$value": ["Exo 2", "system-ui", "sans-serif"]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["Share Tech Mono", "ui-monospace", "monospace"]
    },
    "chrome": {
      "$type": "fontFamily",
      "$value": ["Monoton", "Orbitron", "sans-serif"]
    },
    "script": {
      "$type": "fontFamily",
      "$value": ["Mr Dafoe", "Brush Script MT", "cursive"]
    }
  }
}
