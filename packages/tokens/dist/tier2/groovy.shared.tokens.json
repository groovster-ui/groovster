{
  "$schema": "../../../schema/tokens.schema.json",
  "meta": {
    "tier": 2,
    "era": "groovy",
    "mode": "shared"
  },
  "color": {
    "fg": {
      "default": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "muted": {
        "$type": "color",
        "$value": "{color.avocado}"
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.sand}"
      }
    },
    "bg": {
      "page": {
        "$type": "color",
        "$value": "{color.sand}"
      },
      "surface": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.sand} 95%, {color.harvest} 5%)"
      },
      "elevated": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.sand} 98%, white 2%)"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "{color.harvest}"
      },
      "strong": {
        "$type": "color",
        "$value": "{color.avocado}"
      }
    },
    "action": {
      "bg": {
        "$type": "color",
        "$value": "{color.accent.solid}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.accent.fg}"
      },
      "hover": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.accent.solid} 90%, black 10%)"
      }
    },
    "field": {
      "bg": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.sand} 98%, white 2%)"
      },
      "border": {
        "$type": "color",
        "$value": "{color.harvest}"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.avocado}"
      }
    },
    "overlay": {
      "$type": "color",
      "$value": "color-mix(in oklch, {color.ink} 100%, transparent 60%)"
    },
    "track": {
      "off": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.sand} 90%, {color.harvest} 10%)"
      },
      "on": {
        "$type": "color",
        "$value": "{color.accent.solid}"
      }
    },
    "danger": {
      "bg": {
        "$type": "color",
        "$value": "{color.danger.solid}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.danger.fg}"
      }
    }
  },
  "elevation": {
    "1": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "10px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.ink} 100%, transparent 88%)"
        }
      ]
    },
    "2": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "10px",
          "blur": "24px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.ink} 100%, transparent 84%)"
        }
      ]
    },
    "dialog": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "16px",
          "blur": "40px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.ink} 100%, transparent 80%)"
        }
      ]
    }
  }
}
