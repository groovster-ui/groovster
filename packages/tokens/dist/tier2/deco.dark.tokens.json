{
  "$schema": "../../../schema/tokens.schema.json",
  "meta": {
    "tier": 2,
    "era": "deco",
    "mode": "dark",
    "description": "Tier 2 semantic roles for deco dark (references tier 1)"
  },
  "color": {
    "fg": {
      "default": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "muted": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.ink} 65%, {color.paper})"
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.paper}"
      }
    },
    "bg": {
      "page": {
        "$type": "color",
        "$value": "{color.paper}"
      },
      "surface": {
        "$type": "color",
        "$value": "{color.panel}"
      },
      "elevated": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.panel} 80%, {color.brass})"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "{color.brass}"
      },
      "strong": {
        "$type": "color",
        "$value": "{color.brassDeep}"
      }
    },
    "action": {
      "bg": {
        "$type": "color",
        "$value": "{color.accent.solid}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.accent.fg}"
      },
      "hover": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.accent.solid} 88%, {color.ink})"
      }
    },
    "field": {
      "bg": {
        "$type": "color",
        "$value": "{color.panel}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.brassDeep}"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.brass}"
      }
    },
    "overlay": {
      "$type": "color",
      "$value": "color-mix(in oklch, {color.paper} 70%, transparent)"
    },
    "track": {
      "off": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.panel} 70%, {color.ink})"
      },
      "on": {
        "$type": "color",
        "$value": "{color.accent.solid}"
      }
    },
    "danger": {
      "bg": {
        "$type": "color",
        "$value": "{color.danger.solid}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.danger.fg}"
      }
    }
  },
  "elevation": {
    "1": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "0px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.brass} 40%, transparent)"
        }
      ]
    },
    "2": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "0px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.paper} 55%, transparent)"
        },
        {
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "0px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.brassDeep} 30%, transparent)"
        }
      ]
    },
    "dialog": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "12px",
          "blur": "0px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.paper} 65%, transparent)"
        }
      ]
    }
  }
}
