{
  "$schema": "../../../schema/tokens.schema.json",
  "meta": {
    "tier": 2,
    "era": "deco",
    "mode": "shared",
    "description": "Tier 2 semantic roles for deco"
  },
  "color": {
    "fg": {
      "default": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "muted": {
        "$type": "color",
        "$value": "{color.brassDeep}"
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.paper}"
      }
    },
    "bg": {
      "page": {
        "$type": "color",
        "$value": "{color.paper}"
      },
      "surface": {
        "$type": "color",
        "$value": "{color.panel}"
      },
      "elevated": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.panel} 85%, {color.brass} 15%)"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "{color.brass}"
      },
      "strong": {
        "$type": "color",
        "$value": "{color.brassDeep}"
      }
    },
    "action": {
      "bg": {
        "$type": "color",
        "$value": "{color.accent.solid}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.accent.fg}"
      },
      "hover": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.accent.solid} 85%, black 15%)"
      }
    },
    "field": {
      "bg": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.paper} 95%, {color.panel} 5%)"
      },
      "border": {
        "$type": "color",
        "$value": "{color.brassDeep}"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.brass}"
      }
    },
    "overlay": {
      "$type": "color",
      "$value": "color-mix(in oklch, {color.ink} 100%, transparent 45%)"
    },
    "track": {
      "off": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.panel} 90%, {color.brass} 10%)"
      },
      "on": {
        "$type": "color",
        "$value": "{color.accent.solid}"
      }
    },
    "danger": {
      "bg": {
        "$type": "color",
        "$value": "{color.danger.solid}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.danger.fg}"
      }
    }
  },
  "elevation": {
    "1": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "0px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.brassDeep} 100%, transparent 65%)"
        }
      ]
    },
    "2": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "0px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.ink} 100%, transparent 75%)"
        },
        {
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "0px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.brassDeep} 100%, transparent 80%)"
        }
      ]
    },
    "dialog": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "12px",
          "blur": "0px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.ink} 100%, transparent 65%)"
        }
      ]
    }
  }
}
