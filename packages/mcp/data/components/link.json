{
  "$schema": "../schema/component.schema.json",
  "behavior": "native",
  "sizes": {
    "attribute": "data-size",
    "values": [
      "sm",
      "md",
      "lg"
    ],
    "default": "md"
  },
  "states": [
    {
      "name": "focus-visible",
      "selector": ":focus-visible",
      "description": "Keyboard focus."
    },
    {
      "name": "disabled",
      "selector": ":disabled, [aria-disabled=true]",
      "description": "Non-interactive."
    }
  ],
  "keyboard": [
    {
      "keys": "Enter",
      "action": "Activate"
    }
  ],
  "slots": [
    {
      "name": "default",
      "kind": "content",
      "description": "Primary content."
    }
  ],
  "imports": [
    "@groovster/css/link.css",
    "@groovster/css/eras/<era>.css"
  ],
  "tokenDeps": [
    "color.fg.*",
    "color.bg.*",
    "space.*",
    "radius.*"
  ],
  "id": "link",
  "name": "Link",
  "className": "ew-link",
  "nativeElement": "a",
  "summary": "Text link with era underline/voice.",
  "anatomy": [
    {
      "part": "root",
      "required": true,
      "selector": ".ew-link",
      "description": "Anchor."
    }
  ],
  "variants": {
    "variant": {
      "attribute": "data-variant",
      "values": [
        "default",
        "subtle",
        "nav"
      ],
      "default": "default",
      "description": "Emphasis."
    }
  },
  "aria": {
    "role": "link (native a)",
    "requiredAttributes": [
      "href"
    ],
    "optionalAttributes": [],
    "notes": [
      "Use real <a href>.",
      "Distinguish visited if needed via CSS."
    ]
  },
  "canonicalHtml": "<a class=\"ew-link\" href=\"/pricing\">View pricing</a>",
  "do": [
    "Use href.",
    "Underline or otherwise mark as link beyond color."
  ],
  "dont": [
    "Don't use buttons styled as links for navigation.",
    "Don't remove focus styles."
  ]
}
