{
  "$schema": "../schema/component.schema.json",
  "id": "stat",
  "name": "Stat",
  "summary": "A value, a label, and an up or down delta that is not color alone.",
  "className": "ew-stat",
  "nativeElement": "div",
  "behavior": "css-only",
  "anatomy": [
    {
      "part": "root",
      "required": true,
      "selector": ".ew-stat",
      "description": "Root element."
    }
  ],
  "variants": {
    "variant": {
      "attribute": "data-variant",
      "values": [
        "default"
      ],
      "default": "default",
      "description": "Visual."
    }
  },
  "sizes": {
    "attribute": "data-size",
    "values": [
      "sm",
      "md"
    ],
    "default": "md"
  },
  "states": [
    {
      "name": "hover",
      "selector": ":hover",
      "description": "Pointer hover."
    },
    {
      "name": "focus-visible",
      "selector": ":focus-visible",
      "description": "Keyboard focus."
    },
    {
      "name": "disabled",
      "selector": ":disabled, [aria-disabled=true]",
      "description": "Non-interactive."
    },
    {
      "name": "busy",
      "selector": "[aria-busy=true]",
      "description": "Loading."
    },
    {
      "name": "empty",
      "selector": ".is-empty",
      "description": "No content yet."
    }
  ],
  "aria": {
    "role": "group",
    "requiredAttributes": [],
    "optionalAttributes": [],
    "notes": [
      "data-dir=up or down adds a triangle so the delta is not color alone. Sparkline goes in .ew-stat__spark."
    ]
  },
  "keyboard": [
    {
      "keys": "none",
      "action": "Not interactive."
    }
  ],
  "slots": [
    {
      "name": "default",
      "kind": "content",
      "description": "Content."
    }
  ],
  "canonicalHtml": "<div class=\"ew-stat\"><p class=\"ew-stat__label\">Watched</p><p class=\"ew-stat__value\">128</p><p class=\"ew-stat__delta\" data-dir=\"up\">12%</p></div>",
  "imports": [
    "@groovster/css/stat.css",
    "@groovster/css/eras/<era>.css"
  ],
  "do": [
    "Keep markup era-neutral and set data-era on an ancestor."
  ],
  "dont": [
    "Do not restyle this with a display face or uppercase tracking."
  ],
  "tokenDeps": [
    "color.fg.*",
    "color.bg.*",
    "color.action.*",
    "type.body"
  ]
}
