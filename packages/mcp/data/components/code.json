{
  "$schema": "../schema/component.schema.json",
  "id": "code",
  "name": "Code",
  "summary": "Inline or block code in the era monospace, with a copy slot.",
  "className": "ew-code",
  "nativeElement": "pre",
  "behavior": "css-only",
  "anatomy": [
    {
      "part": "root",
      "required": true,
      "selector": ".ew-code",
      "description": "Root element."
    }
  ],
  "variants": {
    "variant": {
      "attribute": "data-variant",
      "values": [
        "default"
      ],
      "default": "default",
      "description": "Visual."
    }
  },
  "sizes": {
    "attribute": "data-size",
    "values": [
      "sm",
      "md"
    ],
    "default": "md"
  },
  "states": [
    {
      "name": "hover",
      "selector": ":hover",
      "description": "Pointer hover."
    },
    {
      "name": "focus-visible",
      "selector": ":focus-visible",
      "description": "Keyboard focus."
    },
    {
      "name": "disabled",
      "selector": ":disabled, [aria-disabled=true]",
      "description": "Non-interactive."
    },
    {
      "name": "busy",
      "selector": "[aria-busy=true]",
      "description": "Loading."
    },
    {
      "name": "empty",
      "selector": ".is-empty",
      "description": "No content yet."
    }
  ],
  "aria": {
    "role": "none",
    "requiredAttributes": [],
    "optionalAttributes": [],
    "notes": [
      "Use code for inline and pre.ew-code for a block. The copy control is a real button."
    ]
  },
  "keyboard": [
    {
      "keys": "Enter",
      "action": "Activate the copy button when it is focused."
    }
  ],
  "slots": [
    {
      "name": "default",
      "kind": "content",
      "description": "Content."
    }
  ],
  "canonicalHtml": "<pre class=\"ew-code\"><code>npm test</code><button type=\"button\" class=\"ew-button ew-code__copy\">Copy</button></pre>",
  "imports": [
    "@groovster/css/code.css",
    "@groovster/css/eras/<era>.css"
  ],
  "do": [
    "Keep markup era-neutral and set data-era on an ancestor."
  ],
  "dont": [
    "Do not restyle this with a display face or uppercase tracking."
  ],
  "tokenDeps": [
    "color.fg.*",
    "color.bg.*",
    "color.action.*",
    "type.body"
  ]
}
