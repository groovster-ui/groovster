{
  "$schema": "../schema/component.schema.json",
  "id": "media-card",
  "name": "Media card",
  "summary": "Poster or widescreen card with an overlay title and a watched bar.",
  "className": "ew-media-card",
  "nativeElement": "a",
  "behavior": "css-only",
  "anatomy": [
    {
      "part": "root",
      "required": true,
      "selector": ".ew-media-card",
      "description": "Root element."
    }
  ],
  "variants": {
    "ratio": {
      "attribute": "data-ratio",
      "values": [
        "poster",
        "wide"
      ],
      "default": "poster",
      "description": "Frame ratio."
    }
  },
  "sizes": {
    "attribute": "data-size",
    "values": [
      "sm",
      "md"
    ],
    "default": "md"
  },
  "states": [
    {
      "name": "hover",
      "selector": ":hover",
      "description": "Pointer hover."
    },
    {
      "name": "focus-visible",
      "selector": ":focus-visible",
      "description": "Keyboard focus."
    },
    {
      "name": "disabled",
      "selector": ":disabled, [aria-disabled=true]",
      "description": "Non-interactive."
    },
    {
      "name": "busy",
      "selector": "[aria-busy=true]",
      "description": "Loading."
    },
    {
      "name": "empty",
      "selector": ".is-empty",
      "description": "No content yet."
    }
  ],
  "aria": {
    "role": "link",
    "requiredAttributes": [],
    "optionalAttributes": [],
    "notes": [
      "data-ratio=poster is 2:3. data-ratio=wide is 16:9. Hover and focus lift, and reduced motion keeps them still."
    ]
  },
  "keyboard": [
    {
      "keys": "Enter",
      "action": "Open the title."
    }
  ],
  "slots": [
    {
      "name": "default",
      "kind": "content",
      "description": "Content."
    }
  ],
  "canonicalHtml": "<a class=\"ew-media-card\" data-ratio=\"poster\" href=\"#title\"><span class=\"ew-media-card__title\">Night Market</span><span class=\"ew-media-card__progress\" style=\"width:40%\"></span></a>",
  "imports": [
    "@groovster/css/media-card.css",
    "@groovster/css/eras/<era>.css"
  ],
  "do": [
    "Keep markup era-neutral and set data-era on an ancestor."
  ],
  "dont": [
    "Do not restyle this with a display face or uppercase tracking."
  ],
  "tokenDeps": [
    "color.fg.*",
    "color.bg.*",
    "color.action.*",
    "type.body"
  ]
}
