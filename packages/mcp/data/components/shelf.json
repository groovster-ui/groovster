{
  "$schema": "../schema/component.schema.json",
  "id": "shelf",
  "name": "Shelf",
  "summary": "Horizontal title row with scroll-snap and keyboard access.",
  "className": "ew-shelf",
  "nativeElement": "section",
  "behavior": "css-only",
  "anatomy": [
    {
      "part": "root",
      "required": true,
      "selector": ".ew-shelf",
      "description": "Root element."
    }
  ],
  "variants": {
    "variant": {
      "attribute": "data-variant",
      "values": [
        "default"
      ],
      "default": "default",
      "description": "Visual."
    }
  },
  "sizes": {
    "attribute": "data-size",
    "values": [
      "sm",
      "md"
    ],
    "default": "md"
  },
  "states": [
    {
      "name": "hover",
      "selector": ":hover",
      "description": "Pointer hover."
    },
    {
      "name": "focus-visible",
      "selector": ":focus-visible",
      "description": "Keyboard focus."
    },
    {
      "name": "disabled",
      "selector": ":disabled, [aria-disabled=true]",
      "description": "Non-interactive."
    },
    {
      "name": "busy",
      "selector": "[aria-busy=true]",
      "description": "Loading."
    },
    {
      "name": "empty",
      "selector": ".is-empty",
      "description": "No content yet."
    }
  ],
  "aria": {
    "role": "region",
    "requiredAttributes": [],
    "optionalAttributes": [],
    "notes": [
      "The row scrolls on the inline axis. Arrow keys scroll when the row is focused. Children are links or buttons."
    ]
  },
  "keyboard": [
    {
      "keys": "ArrowLeft / ArrowRight",
      "action": "Scroll the shelf when the row is focused."
    }
  ],
  "slots": [
    {
      "name": "default",
      "kind": "content",
      "description": "Content."
    }
  ],
  "canonicalHtml": "<section class=\"ew-shelf\" aria-label=\"Continue\"><h2 class=\"ew-shelf__title ew-title--section\">Continue</h2><div class=\"ew-shelf__row\" tabindex=\"0\"></div></section>",
  "imports": [
    "@groovster/css/shelf.css",
    "@groovster/css/eras/<era>.css"
  ],
  "do": [
    "Keep markup era-neutral and set data-era on an ancestor."
  ],
  "dont": [
    "Do not restyle this with a display face or uppercase tracking."
  ],
  "tokenDeps": [
    "color.fg.*",
    "color.bg.*",
    "color.action.*",
    "type.body"
  ]
}
