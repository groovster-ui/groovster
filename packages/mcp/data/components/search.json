{
  "$schema": "../schema/component.schema.json",
  "id": "search",
  "name": "Search",
  "summary": "Search field with a leading icon, clear button, and optional scope.",
  "className": "ew-search",
  "nativeElement": "search",
  "behavior": "css-only",
  "anatomy": [
    {
      "part": "root",
      "required": true,
      "selector": ".ew-search",
      "description": "Root element."
    }
  ],
  "variants": {
    "variant": {
      "attribute": "data-variant",
      "values": [
        "default"
      ],
      "default": "default",
      "description": "Visual."
    }
  },
  "sizes": {
    "attribute": "data-size",
    "values": [
      "sm",
      "md"
    ],
    "default": "md"
  },
  "states": [
    {
      "name": "hover",
      "selector": ":hover",
      "description": "Pointer hover."
    },
    {
      "name": "focus-visible",
      "selector": ":focus-visible",
      "description": "Keyboard focus."
    },
    {
      "name": "disabled",
      "selector": ":disabled, [aria-disabled=true]",
      "description": "Non-interactive."
    },
    {
      "name": "busy",
      "selector": "[aria-busy=true]",
      "description": "Loading."
    },
    {
      "name": "empty",
      "selector": ".is-empty",
      "description": "No content yet."
    }
  ],
  "aria": {
    "role": "search",
    "requiredAttributes": [],
    "optionalAttributes": [],
    "notes": [
      "The input needs an accessible name. The clear button is a separate control."
    ]
  },
  "keyboard": [
    {
      "keys": "Escape",
      "action": "Clear the field when it has a value."
    },
    {
      "keys": "Enter",
      "action": "Submit the search."
    }
  ],
  "slots": [
    {
      "name": "default",
      "kind": "content",
      "description": "Content."
    }
  ],
  "canonicalHtml": "<search class=\"ew-search\" role=\"search\"><input class=\"ew-text-field__control ew-search__control\" type=\"search\" aria-label=\"Search mail\"><button type=\"button\" class=\"ew-icon-button ew-search__clear\" aria-label=\"Clear search\">×</button></search>",
  "imports": [
    "@groovster/css/search.css",
    "@groovster/css/eras/<era>.css"
  ],
  "do": [
    "Keep markup era-neutral and set data-era on an ancestor."
  ],
  "dont": [
    "Do not restyle this with a display face or uppercase tracking."
  ],
  "tokenDeps": [
    "color.fg.*",
    "color.bg.*",
    "color.action.*",
    "type.body"
  ]
}
