{
  "$schema": "../schema/component.schema.json",
  "id": "typing-indicator",
  "name": "Typing indicator",
  "summary": "Three dots while someone is typing. Static when motion is reduced.",
  "className": "ew-typing-indicator",
  "nativeElement": "span",
  "behavior": "css-only",
  "anatomy": [
    {
      "part": "root",
      "required": true,
      "selector": ".ew-typing-indicator",
      "description": "Root element."
    }
  ],
  "variants": {
    "variant": {
      "attribute": "data-variant",
      "values": [
        "default"
      ],
      "default": "default",
      "description": "Visual."
    }
  },
  "sizes": {
    "attribute": "data-size",
    "values": [
      "sm",
      "md"
    ],
    "default": "md"
  },
  "states": [
    {
      "name": "hover",
      "selector": ":hover",
      "description": "Pointer hover."
    },
    {
      "name": "focus-visible",
      "selector": ":focus-visible",
      "description": "Keyboard focus."
    },
    {
      "name": "disabled",
      "selector": ":disabled, [aria-disabled=true]",
      "description": "Non-interactive."
    },
    {
      "name": "busy",
      "selector": "[aria-busy=true]",
      "description": "Loading."
    },
    {
      "name": "empty",
      "selector": ".is-empty",
      "description": "No content yet."
    }
  ],
  "aria": {
    "role": "status",
    "requiredAttributes": [],
    "optionalAttributes": [],
    "notes": [
      "The accessible name says who is typing. Reduced motion shows still dots."
    ]
  },
  "keyboard": [
    {
      "keys": "none",
      "action": "Not interactive."
    }
  ],
  "slots": [
    {
      "name": "default",
      "kind": "content",
      "description": "Content."
    }
  ],
  "canonicalHtml": "<span class=\"ew-typing-indicator\" role=\"status\" aria-label=\"Maya is typing\"><i></i><i></i><i></i></span>",
  "imports": [
    "@groovster/css/typing-indicator.css",
    "@groovster/css/eras/<era>.css"
  ],
  "do": [
    "Keep markup era-neutral and set data-era on an ancestor."
  ],
  "dont": [
    "Do not restyle this with a display face or uppercase tracking."
  ],
  "tokenDeps": [
    "color.fg.*",
    "color.bg.*",
    "color.action.*",
    "type.body"
  ]
}
