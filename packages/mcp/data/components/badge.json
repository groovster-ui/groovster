{
  "$schema": "../schema/component.schema.json",
  "id": "badge",
  "name": "Badge",
  "summary": "Count or status dot for labels, nav, and reactions.",
  "className": "ew-badge",
  "nativeElement": "span",
  "behavior": "css-only",
  "anatomy": [
    {
      "part": "root",
      "required": true,
      "selector": ".ew-badge",
      "description": "Root element."
    }
  ],
  "variants": {
    "variant": {
      "attribute": "data-variant",
      "values": [
        "count",
        "dot",
        "neutral"
      ],
      "default": "count",
      "description": "Count, dot, or neutral."
    }
  },
  "sizes": {
    "attribute": "data-size",
    "values": [
      "sm",
      "md"
    ],
    "default": "md"
  },
  "states": [
    {
      "name": "hover",
      "selector": ":hover",
      "description": "Pointer hover."
    },
    {
      "name": "focus-visible",
      "selector": ":focus-visible",
      "description": "Keyboard focus."
    },
    {
      "name": "disabled",
      "selector": ":disabled, [aria-disabled=true]",
      "description": "Non-interactive."
    },
    {
      "name": "busy",
      "selector": "[aria-busy=true]",
      "description": "Loading."
    },
    {
      "name": "empty",
      "selector": ".is-empty",
      "description": "No content yet."
    }
  ],
  "aria": {
    "role": "status",
    "requiredAttributes": [],
    "optionalAttributes": [],
    "notes": [
      "A count needs visible text. A dot sets data-variant=dot and an aria-label on the parent."
    ]
  },
  "keyboard": [
    {
      "keys": "none",
      "action": "Not interactive."
    }
  ],
  "slots": [
    {
      "name": "default",
      "kind": "content",
      "description": "Content."
    }
  ],
  "canonicalHtml": "<span class=\"ew-badge\">3</span>",
  "imports": [
    "@groovster/css/badge.css",
    "@groovster/css/eras/<era>.css"
  ],
  "do": [
    "Keep markup era-neutral and set data-era on an ancestor."
  ],
  "dont": [
    "Do not restyle this with a display face or uppercase tracking."
  ],
  "tokenDeps": [
    "color.fg.*",
    "color.bg.*",
    "color.action.*",
    "type.body"
  ]
}
