{
  "$schema": "../schema/component.schema.json",
  "id": "toolbar",
  "name": "Toolbar",
  "summary": "App bar with start, center, and end slots. Optional sticky and overflow.",
  "className": "ew-toolbar",
  "nativeElement": "div",
  "behavior": "css-only",
  "anatomy": [
    {
      "part": "root",
      "required": true,
      "selector": ".ew-toolbar",
      "description": "Root element."
    }
  ],
  "variants": {
    "variant": {
      "attribute": "data-variant",
      "values": [
        "default"
      ],
      "default": "default",
      "description": "Visual."
    }
  },
  "sizes": {
    "attribute": "data-size",
    "values": [
      "sm",
      "md"
    ],
    "default": "md"
  },
  "states": [
    {
      "name": "hover",
      "selector": ":hover",
      "description": "Pointer hover."
    },
    {
      "name": "focus-visible",
      "selector": ":focus-visible",
      "description": "Keyboard focus."
    },
    {
      "name": "disabled",
      "selector": ":disabled, [aria-disabled=true]",
      "description": "Non-interactive."
    },
    {
      "name": "busy",
      "selector": "[aria-busy=true]",
      "description": "Loading."
    },
    {
      "name": "empty",
      "selector": ".is-empty",
      "description": "No content yet."
    }
  ],
  "aria": {
    "role": "toolbar",
    "requiredAttributes": [],
    "optionalAttributes": [],
    "notes": [
      "Put the toolbar group inside a header landmark. Do not set role=toolbar on the header itself.",
      "The group is role=toolbar with an accessible name. Overflow goes in .ew-toolbar__overflow."
    ]
  },
  "keyboard": [
    {
      "keys": "Tab",
      "action": "Move between controls. Arrow keys are optional inside role=toolbar."
    }
  ],
  "slots": [
    {
      "name": "default",
      "kind": "content",
      "description": "Content."
    }
  ],
  "canonicalHtml": "<header><div class=\"ew-toolbar\" role=\"toolbar\" aria-label=\"Mailbox\" data-sticky=\"true\"><div class=\"ew-toolbar__start\"></div><div class=\"ew-toolbar__center\"></div><div class=\"ew-toolbar__end\"></div></div></header>",
  "imports": [
    "@groovster/css/toolbar.css",
    "@groovster/css/eras/<era>.css"
  ],
  "do": [
    "Keep markup era-neutral and set data-era on an ancestor."
  ],
  "dont": [
    "Do not restyle this with a display face or uppercase tracking."
  ],
  "tokenDeps": [
    "color.fg.*",
    "color.bg.*",
    "color.action.*",
    "type.body"
  ]
}
