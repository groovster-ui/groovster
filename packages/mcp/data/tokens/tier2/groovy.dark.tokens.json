{
  "$schema": "../../../schema/tokens.schema.json",
  "meta": {
    "tier": 2,
    "era": "groovy",
    "mode": "dark",
    "description": "Tier 2 semantic roles for groovy dark (references tier 1)"
  },
  "color": {
    "fg": {
      "default": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "muted": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.ink} 78%, {color.sand})"
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.sand}"
      }
    },
    "bg": {
      "page": {
        "$type": "color",
        "$value": "{color.sand}"
      },
      "surface": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.sand} 88%, {color.ink})"
      },
      "elevated": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.sand} 78%, {color.ink})"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "strong": {
        "$type": "color",
        "$value": "{color.ink}"
      }
    },
    "action": {
      "bg": {
        "$type": "color",
        "$value": "{color.accent.solid}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.accent.fg}"
      },
      "hover": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.accent.solid} 88%, {color.ink})"
      }
    },
    "field": {
      "bg": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.sand} 88%, {color.ink})"
      },
      "border": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.violet}"
      }
    },
    "overlay": {
      "$type": "color",
      "$value": "color-mix(in oklch, {color.sand} 70%, transparent)"
    },
    "track": {
      "off": {
        "$type": "color",
        "$value": "{color.sand}"
      },
      "on": {
        "$type": "color",
        "$value": "{color.accent.solid}"
      }
    },
    "danger": {
      "bg": {
        "$type": "color",
        "$value": "{color.danger.solid}"
      },
      "fg": {
        "$type": "color",
        "$value": "#442439"
      }
    }
  },
  "elevation": {
    "1": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "2px",
          "color": "{color.magenta}"
        }
      ]
    },
    "2": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "2px",
          "color": "{color.sun}"
        }
      ]
    },
    "dialog": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "2px",
          "color": "{color.tangerine}"
        }
      ]
    }
  }
}
