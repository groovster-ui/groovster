{
  "$schema": "../../../schema/tokens.schema.json",
  "meta": {
    "tier": 2,
    "era": "neon",
    "mode": "light",
    "description": "Tier 2 semantic roles for neon light (references tier 1)"
  },
  "color": {
    "fg": {
      "default": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "muted": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.ink} 60%, {color.sky})"
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.sky}"
      }
    },
    "bg": {
      "page": {
        "$type": "color",
        "$value": "{color.sky}"
      },
      "surface": {
        "$type": "color",
        "$value": "{color.panel}"
      },
      "elevated": {
        "$type": "color",
        "$value": "#FFFFFF"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.violet} 55%, {color.panel})"
      },
      "strong": {
        "$type": "color",
        "$value": "{color.magenta}"
      }
    },
    "action": {
      "bg": {
        "$type": "color",
        "$value": "{color.accent.solid}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.accent.fg}"
      },
      "hover": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.accent.solid} 88%, {color.ink})"
      }
    },
    "field": {
      "bg": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "border": {
        "$type": "color",
        "$value": "{color.cyan}"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.magenta}"
      }
    },
    "overlay": {
      "$type": "color",
      "$value": "color-mix(in oklch, {color.ink} 45%, transparent)"
    },
    "track": {
      "off": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.violet} 35%, {color.panel})",
        "$description": "Off track ≥3:1 vs ink thumb on dusk surfaces"
      },
      "on": {
        "$type": "color",
        "$value": "{color.accent.solid}"
      }
    },
    "ornament": {
      "primary": { "$type": "color", "$value": "{color.magenta}" },
      "secondary": { "$type": "color", "$value": "{color.cyan}" },
      "tertiary": { "$type": "color", "$value": "{color.sun}" }
    },
    "danger": {
      "bg": {
        "$type": "color",
        "$value": "{color.danger.solid}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.danger.fg}"
      }
    }
  },
  "elevation": {
    "1": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "1px",
          "color": "color-mix(in oklch, {color.magenta} 40%, transparent)"
        }
      ]
    },
    "2": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "12px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.magenta} 25%, transparent)"
        },
        {
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "24px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.ink} 12%, transparent)"
        }
      ]
    },
    "dialog": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "24px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.cyan} 25%, transparent)"
        },
        {
          "offsetX": "0px",
          "offsetY": "20px",
          "blur": "48px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.ink} 18%, transparent)"
        }
      ]
    }
  }
}
