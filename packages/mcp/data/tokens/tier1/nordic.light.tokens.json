{
  "$schema": "../../../schema/tokens.schema.json",
  "meta": {
    "tier": 1,
    "era": "nordic",
    "mode": "light",
    "description": "Nordic light pigments"
  },
  "color": {
    "cream": {
      "$type": "color",
      "$value": "#F5EFE1"
    },
    "sand": {
      "$type": "color",
      "$value": "#E6DFCF"
    },
    "white": {
      "$type": "color",
      "$value": "#FFFCF5"
    },
    "teal": {
      "$type": "color",
      "$value": "#24583C"
    },
    "coral": {
      "$type": "color",
      "$value": "#A72955"
    },
    "mustard": {
      "$type": "color",
      "$value": "#8B590B"
    },
    "ink": {
      "$type": "color",
      "$value": "#26372C"
    },
    "accent": {
      "solid": {
        "$type": "color",
        "$value": "#24583C",
        "$description": "coral primary"
      },
      "fg": {
        "$type": "color",
        "$value": "#FFFCF5"
      }
    },
    "danger": {
