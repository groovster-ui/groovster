    "lg": {
      "$type": "dimension",
      "$value": "20px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    },
    "organic": {
      "$type": "dimension",
      "$value": "26px"
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "League Spartan",
        "sans-serif"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Work Sans",
        "system-ui",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Courier Prime",
        "monospace"
      ]
    }
