{
  "$schema": "../../../schema/tokens.schema.json",
  "meta": {
    "tier": 1,
    "era": "art-nouveau",
    "mode": "dark",
    "description": "Art Nouveau dark palette: leaded green, brass line, madder glass, peacock"
  },
  "color": {
    "paper": {
      "$type": "color",
      "$value": "#101916"
    },
    "panel": {
      "$type": "color",
      "$value": "#1A2820"
    },
    "elevated": {
      "$type": "color",
      "$value": "#24342A"
    },
    "ink": {
      "$type": "color",
      "$value": "#F6E6C4"
    },
    "muted": {
      "$type": "color",
      "$value": "#D4C6A2"
    },
    "sage": {
      "$type": "color",
      "$value": "#9BB59A"
    },
    "leaf": {
      "$type": "color",
      "$value": "#D7E4BC"
    },
    "line": {
      "$type": "color",
      "$value": "#3D5648"
    },
    "strong": {
      "$type": "color",
      "$value": "#C5D2B6"
    },
    "rose": {
      "$type": "color",
      "$value": "#E8B4AA"
    },
    "brass": {
      "$type": "color",
      "$value": "#E6C56A"
    },
    "peacock": {
      "$type": "color",
      "$value": "#8ED4C8"
    },
    "focus": {
      "$type": "color",
      "$value": "#F0D48A"
    },
    "accent": {
      "solid": {
        "$type": "color",
        "$value": "#E4C36A"
      },
      "fg": {
        "$type": "color",
        "$value": "#1A2212"
      }
    },
    "danger": {
      "solid": {
        "$type": "color",
        "$value": "#F0A4A4"
      },
      "fg": {
        "$type": "color",
        "$value": "#1A1412"
      }
    }
  },
  "space": {
    "0": {
      "$type": "dimension",
      "$value": "0px"
    },
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "24px"
    },
    "6": {
      "$type": "dimension",
      "$value": "32px"
    },
    "7": {
      "$type": "dimension",
      "$value": "48px"
    },
    "8": {
      "$type": "dimension",
      "$value": "64px"
    }
  },
  "radius": {
    "none": {
      "$type": "dimension",
      "$value": "0px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "9px"
    },
    "md": {
      "$type": "dimension",
      "$value": "14px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "24px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Cormorant Garamond",
        "Palatino",
        "Georgia",
        "serif"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Source Sans 3",
        "system-ui",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Source Code Pro",
        "monospace"
      ]
    }
  }
}
