{
  "$schema": "../../../schema/tokens.schema.json",
  "meta": {
    "tier": 1,
    "era": "mcm-atomic",
    "mode": "light",
    "description": "Tier 1 — Formica day (cream + turquoise/coral/mustard)"
  },
  "color": {
    "cream": {
      "$type": "color",
      "$value": "#F3E9D2",
      "$description": "Formica day page"
    },
    "sand": {
      "$type": "color",
      "$value": "#E8DCC4",
      "$description": "warm surface"
    },
    "white": {
      "$type": "color",
      "$value": "#FFFBF3",
      "$description": "field fill"
    },
    "teal": {
      "$type": "color",
      "$value": "#0F6E6B",
      "$description": "turquoise — card bands, secondary"
    },
    "coral": {
      "$type": "color",
      "$value": "#B23A2A",
      "$description": "primary action / switch on"
    },
    "mustard": {
      "$type": "color",
      "$value": "#C4922A",
      "$description": "focus ring / accents"
    },
    "ink": {
      "$type": "color",
      "$value": "#2A2522",
      "$description": "charcoal outlines and body text"
    },
    "accent": {
      "solid": {
        "$type": "color",
        "$value": "#B23A2A",
        "$description": "coral primary"
      },
      "fg": {
        "$type": "color",
        "$value": "#FFFbf3"
      }
    },
    "danger": {
      "solid": {
        "$type": "color",
        "$value": "#8E1B1B"
      },
      "fg": {
        "$type": "color",
        "$value": "#FFFbf3"
      }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "48px" },
    "8": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0px" },
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "18px" },
    "pill": { "$type": "dimension", "$value": "999px" },
    "organic": { "$type": "dimension", "$value": "28px" }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": ["League Spartan", "Futura", "sans-serif"]
    },
    "body": {
      "$type": "fontFamily",
      "$value": ["Work Sans", "system-ui", "sans-serif"]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["Courier Prime", "ui-monospace", "monospace"]
    },
    "script": {
      "$type": "fontFamily",
      "$value": ["Yellowtail", "cursive"]
    },
    "displayAlt": {
      "$type": "fontFamily",
      "$value": ["Oswald", "League Spartan", "sans-serif"]
    }
  }
}
