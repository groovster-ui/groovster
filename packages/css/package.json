{
  "name": "@groovster/css",
  "version": "0.1.0-alpha.0",
  "description": "Generated CSS packs for Era Widgets. Self-contained \u2014 no @import inside published CSS.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": "./dist/era-widgets.css",
    "./era-widgets.css": "./dist/era-widgets.css",
    "./base.css": "./dist/base.css",
    "./button.css": "./dist/button.css",
    "./card.css": "./dist/card.css",
    "./dialog.css": "./dist/dialog.css",
    "./tabs.css": "./dist/tabs.css",
    "./switch.css": "./dist/switch.css",
    "./text-field.css": "./dist/text-field.css",
    "./eras/*.css": "./dist/eras/*.css",
    "./*": "./dist/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/groovster-ui/groovster.git",
    "directory": "packages/css"
  },
  "keywords": [
    "era-widgets",
    "css",
    "design-systems",
    "art-deco",
    "synthwave"
  ]
}
