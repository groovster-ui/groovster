{
  "$schema": "../../../schema/tokens.schema.json",
  "meta": {
    "tier": 2,
    "era": "mcm-atomic",
    "mode": "light",
    "description": "Tier 2 semantic roles for mcm-atomic light (references tier 1)"
  },
  "color": {
    "fg": {
      "default": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "muted": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.ink} 72%, {color.cream})"
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.cream}"
      }
    },
    "bg": {
      "page": {
        "$type": "color",
        "$value": "{color.cream}"
      },
      "surface": {
        "$type": "color",
        "$value": "{color.sand}"
      },
      "elevated": {
        "$type": "color",
        "$value": "{color.cream}"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.ink} 18%, {color.cream})"
      },
      "strong": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.ink} 35%, {color.cream})"
      }
    },
    "action": {
      "bg": {
        "$type": "color",
        "$value": "{color.accent.solid}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.accent.fg}"
      },
      "hover": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.accent.solid} 85%, {color.ink})"
      }
    },
    "field": {
      "bg": {
        "$type": "color",
        "$value": "{color.cream}"
      },
      "border": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.ink} 25%, {color.cream})"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.teal}"
      }
    },
    "overlay": {
      "$type": "color",
      "$value": "color-mix(in oklch, {color.ink} 40%, transparent)"
    },
    "track": {
      "off": {
        "$type": "color",
        "$value": "{color.sand}"
      },
      "on": {
        "$type": "color",
        "$value": "{color.accent.solid}"
      }
    },
    "danger": {
      "bg": {
        "$type": "color",
        "$value": "{color.danger.solid}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.danger.fg}"
      }
    }
  },
  "elevation": {
    "1": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "8px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.ink} 10%, transparent)"
        }
      ]
    },
    "2": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "24px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.ink} 14%, transparent)"
        }
      ]
    },
    "dialog": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "20px",
          "blur": "48px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.ink} 18%, transparent)"
        }
      ]
    }
  }
}
