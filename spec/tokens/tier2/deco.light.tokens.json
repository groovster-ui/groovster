{
  "$schema": "../../../schema/tokens.schema.json",
  "meta": {
    "tier": 2,
    "era": "deco",
    "mode": "light",
    "description": "Tier 2 semantic roles for deco light (references tier 1)"
  },
  "color": {
    "fg": {
      "default": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "muted": {
        "$type": "color",
        "$value": "{color.cream}"
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.paper}"
      }
    },
    "bg": {
      "page": {
        "$type": "color",
        "$value": "{color.paper}"
      },
      "surface": {
        "$type": "color",
        "$value": "{color.panel}"
      },
      "elevated": {
        "$type": "color",
        "$value": "{color.sky}",
        "$description": "Bible elevated surface (dark lacquer step / light white)"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "{color.goldSubtle}"
      },
      "strong": {
        "$type": "color",
        "$value": "{color.gold}"
      }
    },
    "action": {
      "bg": {
        "$type": "color",
        "$value": "{color.accent.solid}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.accent.fg}"
      },
      "hover": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.accent.solid} 85%, {color.ink})"
      }
    },
    "field": {
      "bg": {
        "$type": "color",
        "$value": "{color.paper}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.goldBorder}"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.goldFocus}"
      }
    },
    "overlay": {
      "$type": "color",
      "$value": "color-mix(in oklch, {color.ink} 55%, transparent)"
    },
    "track": {
      "off": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.panel} 90%, {color.brass} 10%)"
      },
      "on": {
        "$type": "color",
        "$value": "{color.accent.solid}"
      }
    },
    "danger": {
      "bg": {
        "$type": "color",
        "$value": "{color.danger.solid}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.danger.fg}"
      }
    }
  },
  "elevation": {
    "1": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "0px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.brassDeep} 35%, transparent)"
        }
      ]
    },
    "2": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "0px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.ink} 25%, transparent)"
        },
        {
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "0px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.brassDeep} 20%, transparent)"
        }
      ]
    },
    "dialog": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "12px",
          "blur": "0px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.ink} 35%, transparent)"
        }
      ]
    }
  }
}
