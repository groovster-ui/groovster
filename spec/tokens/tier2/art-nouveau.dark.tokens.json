{
  "$schema": "../../../schema/tokens.schema.json",
  "meta": {
    "tier": 2,
    "era": "art-nouveau",
    "mode": "dark",
    "description": "Semantic Art Nouveau dark controls and surfaces"
  },
  "color": {
    "fg": {
      "default": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "muted": {
        "$type": "color",
        "$value": "{color.muted}"
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.paper}"
      }
    },
    "bg": {
      "page": {
        "$type": "color",
        "$value": "{color.paper}"
      },
      "surface": {
        "$type": "color",
        "$value": "{color.panel}"
      },
      "elevated": {
        "$type": "color",
        "$value": "{color.elevated}"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "{color.line}"
      },
      "strong": {
        "$type": "color",
        "$value": "{color.strong}"
      }
    },
    "action": {
      "bg": {
        "$type": "color",
        "$value": "{color.accent.solid}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.accent.fg}"
      },
      "hover": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.accent.solid} 84%, {color.ink})"
      }
    },
    "field": {
      "bg": {
        "$type": "color",
        "$value": "{color.elevated}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.strong}"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.focus}"
      }
    },
    "overlay": {
      "$type": "color",
      "$value": "color-mix(in oklch, {color.paper} 45%, transparent)"
    },
    "track": {
      "off": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.paper} 48%, {color.strong})"
      },
      "on": {
        "$type": "color",
        "$value": "{color.accent.solid}"
      }
    },
    "danger": {
      "bg": {
        "$type": "color",
        "$value": "{color.danger.solid}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.danger.fg}"
      }
    }
  },
  "elevation": {
    "1": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "6px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.ink} 16%, transparent)"
        }
      ]
    },
    "2": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "6px",
          "blur": "18px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.ink} 22%, transparent)"
        }
      ]
    },
    "dialog": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "16px",
          "blur": "36px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.ink} 35%, transparent)"
        }
      ]
    }
  }
}
