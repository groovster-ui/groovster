{
  "$schema": "../../../schema/tokens.schema.json",
  "meta": {
    "tier": 2,
    "era": "groovy",
    "mode": "shared"
  },
  "color": {
    "fg": {
      "default": {
        "$type": "color",
        "$value": "oklch(28% 0.03 60)"
      },
      "muted": {
        "$type": "color",
        "$value": "oklch(45% 0.04 70)"
      },
      "inverse": {
        "$type": "color",
        "$value": "oklch(96% 0.02 95)"
      }
    },
    "bg": {
      "page": {
        "$type": "color",
        "$value": "oklch(94% 0.03 85)"
      },
      "surface": {
        "$type": "color",
        "$value": "oklch(90% 0.04 85)"
      },
      "elevated": {
        "$type": "color",
        "$value": "oklch(97% 0.02 90)"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "oklch(75% 0.05 85)"
      },
      "strong": {
        "$type": "color",
        "$value": "oklch(50% 0.08 130)"
      }
    },
    "action": {
      "bg": {
        "$type": "color",
        "$value": "oklch(42% 0.1 130)"
      },
      "fg": {
        "$type": "color",
        "$value": "oklch(97% 0.02 95)"
      },
      "hover": {
        "$type": "color",
        "$value": "oklch(38% 0.1 130)"
      }
    },
    "field": {
      "bg": {
        "$type": "color",
        "$value": "oklch(97% 0.02 90)"
      },
      "border": {
        "$type": "color",
        "$value": "oklch(60% 0.06 85)"
      },
      "focus": {
        "$type": "color",
        "$value": "oklch(50% 0.1 130)"
      }
    },
    "overlay": {
      "$type": "color",
      "$value": "oklch(28% 0.03 60 / 0.4)"
    },
    "track": {
      "off": {
        "$type": "color",
        "$value": "oklch(85% 0.03 85)"
      },
      "on": {
        "$type": "color",
        "$value": "oklch(42% 0.1 130)"
      }
    },
    "danger": {
      "bg": {
        "$type": "color",
        "$value": "oklch(40% 0.14 35)"
      },
      "fg": {
        "$type": "color",
        "$value": "oklch(97% 0.02 95)"
      }
    }
  },
  "elevation": {
    "1": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "10px",
          "spread": "0px",
          "color": "oklch(28% 0.03 60 / 0.12)"
        }
      ]
    },
    "2": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "10px",
          "blur": "24px",
          "spread": "0px",
          "color": "oklch(28% 0.03 60 / 0.16)"
        }
      ]
    },
    "dialog": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "16px",
          "blur": "40px",
          "spread": "0px",
          "color": "oklch(28% 0.03 60 / 0.2)"
        }
      ]
    }
  }
}
