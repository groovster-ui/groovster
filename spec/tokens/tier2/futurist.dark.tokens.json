{
  "$schema": "../../../schema/tokens.schema.json",
  "meta": {
    "tier": 2,
    "era": "futurist",
    "mode": "dark",
    "description": "Futurist dark semantic roles"
  },
  "color": {
    "fg": {
      "default": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "muted": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.ink} 70%, {color.cream})"
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.cream}"
      }
    },
    "bg": {
      "page": {
        "$type": "color",
        "$value": "{color.cream}"
      },
      "surface": {
        "$type": "color",
        "$value": "{color.sand}"
      },
      "elevated": {
        "$type": "color",
        "$value": "{color.white}"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.ink} 28%, {color.cream})"
      },
      "strong": {
        "$type": "color",
        "$value": "{color.ink}"
      }
    },
    "action": {
      "bg": {
        "$type": "color",
        "$value": "{color.accent.solid}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.accent.fg}"
      },
      "hover": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.accent.solid} 88%, {color.cream})"
      }
    },
    "field": {
      "bg": {
        "$type": "color",
        "$value": "{color.white}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.mustard}"
      }
    },
    "overlay": {
      "$type": "color",
      "$value": "color-mix(in oklch, {color.cream} 72%, transparent)"
    },
    "track": {
      "off": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.ink} 55%, {color.cream})"
      },
      "on": {
        "$type": "color",
        "$value": "{color.accent.solid}"
      }
    },
    "danger": {
      "bg": {
        "$type": "color",
        "$value": "{color.danger.solid}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.danger.fg}"
      }
    }
  },
  "elevation": {
    "1": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "4px",
          "offsetY": "4px",
          "blur": "0px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.ink} 18%, transparent)"
        }
      ]
    },
    "2": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "6px",
          "offsetY": "6px",
          "blur": "0px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.ink} 24%, transparent)"
        }
      ]
    },
    "dialog": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "8px",
          "offsetY": "8px",
          "blur": "0px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.ink} 30%, transparent)"
        }
      ]
    }
  }
}
