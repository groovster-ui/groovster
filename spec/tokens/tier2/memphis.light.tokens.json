{
  "$schema": "../../../schema/tokens.schema.json",
  "meta": {
    "tier": 2,
    "era": "memphis",
    "mode": "light",
    "description": "Tier 2 semantic roles for memphis light (references tier 1)"
  },
  "color": {
    "fg": {
      "default": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "muted": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.ink} 72%, {color.cream})"
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.cream}"
      }
    },
    "bg": {
      "page": {
        "$type": "color",
        "$value": "{color.cream}"
      },
      "surface": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.cream} 92%, {color.yellow})"
      },
      "elevated": {
        "$type": "color",
        "$value": "{color.cream}"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "strong": {
        "$type": "color",
        "$value": "{color.ink}"
      }
    },
    "action": {
      "bg": {
        "$type": "color",
        "$value": "{color.accent.solid}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.accent.fg}"
      },
      "hover": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.accent.solid} 85%, {color.ink})"
      }
    },
    "field": {
      "bg": {
        "$type": "color",
        "$value": "{color.cream}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.blue}"
      }
    },
    "overlay": {
      "$type": "color",
      "$value": "color-mix(in oklch, {color.ink} 40%, transparent)"
    },
    "track": {
      "off": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.cream} 80%, {color.ink})"
      },
      "on": {
        "$type": "color",
        "$value": "{color.accent.solid}"
      }
    },
    "danger": {
      "bg": {
        "$type": "color",
        "$value": "{color.danger.solid}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.danger.fg}"
      }
    }
  },
  "elevation": {
    "1": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "4px",
          "offsetY": "4px",
          "blur": "0px",
          "spread": "0px",
          "color": "{color.ink}"
        }
      ]
    },
    "2": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "6px",
          "offsetY": "6px",
          "blur": "0px",
          "spread": "0px",
          "color": "{color.ink}"
        }
      ]
    },
    "dialog": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "10px",
          "offsetY": "10px",
          "blur": "0px",
          "spread": "0px",
          "color": "{color.ink}"
        }
      ]
    }
  }
}
