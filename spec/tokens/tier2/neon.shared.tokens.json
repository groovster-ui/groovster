{
  "$schema": "../../../schema/tokens.schema.json",
  "meta": {
    "tier": 2,
    "era": "neon",
    "mode": "shared",
    "description": "Tier 2 semantic roles for neon"
  },
  "color": {
    "fg": {
      "default": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "muted": {
        "$type": "color",
        "$value": "{color.cyan}"
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.sky}"
      }
    },
    "bg": {
      "page": {
        "$type": "color",
        "$value": "{color.sky}"
      },
      "surface": {
        "$type": "color",
        "$value": "{color.panel}"
      },
      "elevated": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.panel} 85%, {color.violet} 15%)"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "{color.violet}"
      },
      "strong": {
        "$type": "color",
        "$value": "{color.magenta}"
      }
    },
    "action": {
      "bg": {
        "$type": "color",
        "$value": "{color.accent.solid}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.accent.fg}"
      },
      "hover": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.magenta} 95%, white 5%)"
      }
    },
    "field": {
      "bg": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.panel} 90%, {color.sky} 10%)"
      },
      "border": {
        "$type": "color",
        "$value": "{color.cyan}"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.cyan}"
      }
    },
    "overlay": {
      "$type": "color",
      "$value": "color-mix(in oklch, {color.sky} 100%, transparent 30%)"
    },
    "track": {
      "off": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.panel} 85%, {color.violet} 15%)"
      },
      "on": {
        "$type": "color",
        "$value": "{color.magenta}"
      }
    },
    "danger": {
      "bg": {
        "$type": "color",
        "$value": "{color.danger.solid}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.danger.fg}"
      }
    }
  },
  "elevation": {
    "1": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "1px",
          "color": "color-mix(in oklch, {color.magenta} 100%, transparent 45%)"
        }
      ]
    },
    "2": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "12px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.magenta} 100%, transparent 65%)"
        },
        {
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "24px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.sky} 100%, transparent 40%)"
        }
      ]
    },
    "dialog": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "24px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.cyan} 100%, transparent 65%)"
        },
        {
          "offsetX": "0px",
          "offsetY": "20px",
          "blur": "48px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.sky} 100%, transparent 30%)"
        }
      ]
    }
  }
}
