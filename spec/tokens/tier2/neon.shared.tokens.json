{
  "$schema": "../../../schema/tokens.schema.json",
  "meta": {
    "tier": 2,
    "era": "neon",
    "mode": "shared",
    "description": "Tier 2 semantic roles for neon"
  },
  "color": {
    "fg": {
      "default": {
        "$type": "color",
        "$value": "oklch(95% 0.02 300)"
      },
      "muted": {
        "$type": "color",
        "$value": "oklch(75% 0.05 300)"
      },
      "inverse": {
        "$type": "color",
        "$value": "oklch(12% 0.05 300)"
      }
    },
    "bg": {
      "page": {
        "$type": "color",
        "$value": "oklch(12% 0.05 300)"
      },
      "surface": {
        "$type": "color",
        "$value": "oklch(18% 0.06 300)"
      },
      "elevated": {
        "$type": "color",
        "$value": "oklch(22% 0.07 300)"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "oklch(45% 0.12 300)"
      },
      "strong": {
        "$type": "color",
        "$value": "oklch(68% 0.25 340)"
      }
    },
    "action": {
      "bg": {
        "$type": "color",
        "$value": "oklch(68% 0.25 340)"
      },
      "fg": {
        "$type": "color",
        "$value": "oklch(12% 0.04 300)"
      },
      "hover": {
        "$type": "color",
        "$value": "oklch(72% 0.22 340)"
      }
    },
    "field": {
      "bg": {
        "$type": "color",
        "$value": "oklch(16% 0.05 300)"
      },
      "border": {
        "$type": "color",
        "$value": "oklch(75% 0.14 210)"
      },
      "focus": {
        "$type": "color",
        "$value": "oklch(75% 0.14 210)"
      }
    },
    "overlay": {
      "$type": "color",
      "$value": "oklch(8% 0.05 300 / 0.7)"
    },
    "track": {
      "off": {
        "$type": "color",
        "$value": "oklch(28% 0.05 300)"
      },
      "on": {
        "$type": "color",
        "$value": "oklch(68% 0.25 340)"
      }
    },
    "danger": {
      "bg": {
        "$type": "color",
        "$value": "oklch(65% 0.18 25)"
      },
      "fg": {
        "$type": "color",
        "$value": "oklch(12% 0.02 25)"
      }
    }
  },
  "elevation": {
    "1": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "1px",
          "color": "oklch(68% 0.25 340 / 0.55)"
        }
      ]
    },
    "2": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "12px",
          "spread": "0px",
          "color": "oklch(68% 0.25 340 / 0.35)"
        },
        {
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "24px",
          "spread": "0px",
          "color": "oklch(8% 0.05 300 / 0.6)"
        }
      ]
    },
    "dialog": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "24px",
          "spread": "0px",
          "color": "oklch(75% 0.14 210 / 0.35)"
        },
        {
          "offsetX": "0px",
          "offsetY": "20px",
          "blur": "48px",
          "spread": "0px",
          "color": "oklch(8% 0.05 300 / 0.7)"
        }
      ]
    }
  }
}
