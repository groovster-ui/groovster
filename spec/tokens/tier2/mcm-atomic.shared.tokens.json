{
  "$schema": "../../../schema/tokens.schema.json",
  "meta": {
    "tier": 2,
    "era": "mcm-atomic",
    "mode": "shared",
    "description": "Tier 2 semantic roles for mcm-atomic"
  },
  "color": {
    "fg": {
      "default": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "muted": {
        "$type": "color",
        "$value": "{color.teal}"
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.cream}"
      }
    },
    "bg": {
      "page": {
        "$type": "color",
        "$value": "{color.cream}"
      },
      "surface": {
        "$type": "color",
        "$value": "{color.sand}"
      },
      "elevated": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.cream} 95%, {color.mustard} 5%)"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "{color.mustard}"
      },
      "strong": {
        "$type": "color",
        "$value": "{color.teal}"
      }
    },
    "action": {
      "bg": {
        "$type": "color",
        "$value": "{color.accent.solid}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.accent.fg}"
      },
      "hover": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.accent.solid} 90%, black 10%)"
      }
    },
    "field": {
      "bg": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.cream} 97%, {color.sand} 3%)"
      },
      "border": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.mustard} 80%, {color.teal} 20%)"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.teal}"
      }
    },
    "overlay": {
      "$type": "color",
      "$value": "color-mix(in oklch, {color.ink} 100%, transparent 60%)"
    },
    "track": {
      "off": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.sand} 90%, {color.mustard} 10%)"
      },
      "on": {
        "$type": "color",
        "$value": "{color.accent.solid}"
      }
    },
    "danger": {
      "bg": {
        "$type": "color",
        "$value": "{color.danger.solid}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.danger.fg}"
      }
    }
  },
  "elevation": {
    "1": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "6px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.ink} 100%, transparent 90%)"
        }
      ]
    },
    "2": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "4px",
          "offsetY": "4px",
          "blur": "0px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.ink} 100%, transparent 85%)"
        }
      ]
    },
    "dialog": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "12px",
          "blur": "28px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.ink} 100%, transparent 82%)"
        }
      ]
    }
  }
}
