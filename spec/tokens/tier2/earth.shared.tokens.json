{
  "$schema": "../../../schema/tokens.schema.json",
  "meta": {
    "tier": 2,
    "era": "earth",
    "mode": "shared"
  },
  "color": {
    "fg": {
      "default": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "muted": {
        "$type": "color",
        "$value": "{color.moss}"
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.sand}"
      }
    },
    "bg": {
      "page": {
        "$type": "color",
        "$value": "{color.sand}"
      },
      "surface": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.sand} 95%, {color.clay} 5%)"
      },
      "elevated": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.sand} 98%, white 2%)"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "{color.clay}"
      },
      "strong": {
        "$type": "color",
        "$value": "{color.moss}"
      }
    },
    "action": {
      "bg": {
        "$type": "color",
        "$value": "{color.accent.solid}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.accent.fg}"
      },
      "hover": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.accent.solid} 90%, black 10%)"
      }
    },
    "field": {
      "bg": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.sand} 98%, white 2%)"
      },
      "border": {
        "$type": "color",
        "$value": "{color.clay}"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.moss}"
      }
    },
    "overlay": {
      "$type": "color",
      "$value": "color-mix(in oklch, {color.ink} 100%, transparent 60%)"
    },
    "track": {
      "off": {
        "$type": "color",
        "$value": "color-mix(in oklch, {color.sand} 90%, {color.clay} 10%)"
      },
      "on": {
        "$type": "color",
        "$value": "{color.accent.solid}"
      }
    },
    "danger": {
      "bg": {
        "$type": "color",
        "$value": "{color.danger.solid}"
      },
      "fg": {
        "$type": "color",
        "$value": "{color.danger.fg}"
      }
    }
  },
  "elevation": {
    "1": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "6px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.ink} 100%, transparent 90%)"
        }
      ]
    },
    "2": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "20px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.ink} 100%, transparent 86%)"
        }
      ]
    },
    "dialog": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "16px",
          "blur": "36px",
          "spread": "0px",
          "color": "color-mix(in oklch, {color.ink} 100%, transparent 82%)"
        }
      ]
    }
  }
}
