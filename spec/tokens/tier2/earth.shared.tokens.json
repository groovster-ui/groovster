{
  "$schema": "../../../schema/tokens.schema.json",
  "meta": {
    "tier": 2,
    "era": "earth",
    "mode": "shared"
  },
  "color": {
    "fg": {
      "default": {
        "$type": "color",
        "$value": "oklch(30% 0.03 70)"
      },
      "muted": {
        "$type": "color",
        "$value": "oklch(48% 0.03 70)"
      },
      "inverse": {
        "$type": "color",
        "$value": "oklch(96% 0.01 90)"
      }
    },
    "bg": {
      "page": {
        "$type": "color",
        "$value": "oklch(95% 0.02 90)"
      },
      "surface": {
        "$type": "color",
        "$value": "oklch(91% 0.025 90)"
      },
      "elevated": {
        "$type": "color",
        "$value": "oklch(97% 0.015 90)"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "oklch(78% 0.03 70)"
      },
      "strong": {
        "$type": "color",
        "$value": "oklch(55% 0.05 50)"
      }
    },
    "action": {
      "bg": {
        "$type": "color",
        "$value": "oklch(40% 0.06 145)"
      },
      "fg": {
        "$type": "color",
        "$value": "oklch(97% 0.01 90)"
      },
      "hover": {
        "$type": "color",
        "$value": "oklch(36% 0.06 145)"
      }
    },
    "field": {
      "bg": {
        "$type": "color",
        "$value": "oklch(98% 0.01 90)"
      },
      "border": {
        "$type": "color",
        "$value": "oklch(65% 0.04 70)"
      },
      "focus": {
        "$type": "color",
        "$value": "oklch(45% 0.06 145)"
      }
    },
    "overlay": {
      "$type": "color",
      "$value": "oklch(30% 0.03 70 / 0.4)"
    },
    "track": {
      "off": {
        "$type": "color",
        "$value": "oklch(85% 0.02 90)"
      },
      "on": {
        "$type": "color",
        "$value": "oklch(40% 0.06 145)"
      }
    },
    "danger": {
      "bg": {
        "$type": "color",
        "$value": "oklch(40% 0.12 35)"
      },
      "fg": {
        "$type": "color",
        "$value": "oklch(97% 0.02 95)"
      }
    }
  },
  "elevation": {
    "1": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "6px",
          "spread": "0px",
          "color": "oklch(30% 0.03 70 / 0.1)"
        }
      ]
    },
    "2": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "20px",
          "spread": "0px",
          "color": "oklch(30% 0.03 70 / 0.14)"
        }
      ]
    },
    "dialog": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "16px",
          "blur": "36px",
          "spread": "0px",
          "color": "oklch(30% 0.03 70 / 0.18)"
        }
      ]
    }
  }
}
