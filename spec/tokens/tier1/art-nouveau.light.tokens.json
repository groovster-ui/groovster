{
  "$schema": "../../../schema/tokens.schema.json",
  "meta": {
    "tier": 1,
    "era": "art-nouveau",
    "mode": "light",
    "description": "Art Nouveau light palette: warm parchment, olive line, madder, antique gold, peacock"
  },
  "color": {
    "paper": {
      "$type": "color",
      "$value": "#F4E8CC"
    },
    "panel": {
      "$type": "color",
      "$value": "#FFF6E4"
    },
    "elevated": {
      "$type": "color",
      "$value": "#FFFCF4"
    },
    "ink": {
      "$type": "color",
      "$value": "#1C2616"
    },
    "muted": {
      "$type": "color",
      "$value": "#3C5340"
    },
    "sage": {
      "$type": "color",
      "$value": "#7E9874"
    },
    "leaf": {
      "$type": "color",
      "$value": "#245C40"
    },
    "line": {
      "$type": "color",
      "$value": "#D9CBA8"
    },
    "strong": {
      "$type": "color",
      "$value": "#4A5C3C"
    },
    "rose": {
      "$type": "color",
      "$value": "#B55256"
    },
    "brass": {
      "$type": "color",
      "$value": "#A67C32"
    },
    "peacock": {
      "$type": "color",
      "$value": "#1A6A60"
    },
    "focus": {
      "$type": "color",
      "$value": "#7A4E12"
    },
    "accent": {
      "solid": {
        "$type": "color",
        "$value": "#123E34"
      },
      "fg": {
        "$type": "color",
        "$value": "#FFF6E4"
      }
    },
    "danger": {
      "solid": {
        "$type": "color",
        "$value": "#8C2E36"
      },
      "fg": {
        "$type": "color",
        "$value": "#FFFFFF"
      }
    }
  },
  "space": {
    "0": {
      "$type": "dimension",
      "$value": "0px"
    },
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "24px"
    },
    "6": {
      "$type": "dimension",
      "$value": "32px"
    },
    "7": {
      "$type": "dimension",
      "$value": "48px"
    },
    "8": {
      "$type": "dimension",
      "$value": "64px"
    }
  },
  "radius": {
    "none": {
      "$type": "dimension",
      "$value": "0px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "9px"
    },
    "md": {
      "$type": "dimension",
      "$value": "14px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "24px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Cormorant Garamond",
        "Palatino",
        "Georgia",
        "serif"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Source Sans 3",
        "system-ui",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Source Code Pro",
        "monospace"
      ]
    }
  }
}
