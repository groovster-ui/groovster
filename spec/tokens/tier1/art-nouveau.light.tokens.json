{
  "$schema": "../../../schema/tokens.schema.json",
  "meta": {
    "tier": 1,
    "era": "art-nouveau",
    "mode": "light",
    "description": "Original Art Nouveau light lithographic material palette"
  },
  "color": {
    "paper": {
      "$type": "color",
      "$value": "#F5F0E2"
    },
    "panel": {
      "$type": "color",
      "$value": "#FCF7EA"
    },
    "elevated": {
      "$type": "color",
      "$value": "#FFFDF5"
    },
    "ink": {
      "$type": "color",
      "$value": "#26372E"
    },
    "muted": {
      "$type": "color",
      "$value": "#4C5B4F"
    },
    "sage": {
      "$type": "color",
      "$value": "#748D79"
    },
    "leaf": {
      "$type": "color",
      "$value": "#4B704E"
    },
    "line": {
      "$type": "color",
      "$value": "#B8BCA5"
    },
    "strong": {
      "$type": "color",
      "$value": "#5E7763"
    },
    "rose": {
      "$type": "color",
      "$value": "#BA827E"
    },
    "brass": {
      "$type": "color",
      "$value": "#917645"
    },
    "focus": {
      "$type": "color",
      "$value": "#91682C"
    },
    "accent": {
      "solid": {
        "$type": "color",
        "$value": "#285747"
      },
      "fg": {
        "$type": "color",
        "$value": "#FFFDF5"
      }
    },
    "danger": {
      "solid": {
        "$type": "color",
        "$value": "#943A45"
      },
      "fg": {
        "$type": "color",
        "$value": "#FFFFFF"
      }
    }
  },
  "space": {
    "0": {
      "$type": "dimension",
      "$value": "0px"
    },
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "24px"
    },
    "6": {
      "$type": "dimension",
      "$value": "32px"
    },
    "7": {
      "$type": "dimension",
      "$value": "48px"
    },
    "8": {
      "$type": "dimension",
      "$value": "64px"
    }
  },
  "radius": {
    "none": {
      "$type": "dimension",
      "$value": "0px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "9px"
    },
    "md": {
      "$type": "dimension",
      "$value": "14px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "24px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Fraunces",
        "Georgia",
        "serif"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Jost",
        "system-ui",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Source Code Pro",
        "monospace"
      ]
    }
  }
}
