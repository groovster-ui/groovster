{
  "$schema": "../../schema/era.schema.json",
  "id": "neutral",
  "name": "Neutral",
  "aliases": [
    "base",
    "default"
  ],
  "identity": {
    "oneLiner": "Quiet modern system skin \u2014 the default before personality.",
    "summary": "Neutral is the unopinionated baseline: soft geometry, flat-to-subtle elevation, readable sans, no ornaments. Other eras remix structure on top of this contract.",
    "bestFit": [
      "Serious product UI",
      "Admin / settings",
      "Brand overlay host",
      "Low-fidelity starts"
    ],
    "authenticityNotes": "Should feel invisible. If it reads as a theme, fidelity is too high."
  },
  "axes": {
    "shape": "Soft rectangles; modest radius; no clip-path drama",
    "edge": "1px hairline borders; no stepped or neon bezels",
    "surface": "Flat fills with slight tonal separation",
    "elevation": "Soft shadow ladder; no hard deco steps or neon bloom",
    "ornament": "None \u2014 decorator slots empty by default",
    "typeVoice": "Neutral humanist/geometric sans; sentence case",
    "motion": "Short ease-out; functional only",
    "density": "Comfortable product density",
    "iconography": "Simple stroke icons; 1.5\u20132px"
  },
  "fonts": {
    "display": "Source Serif 4",
    "body": "Source Sans 3",
    "mono": "Source Code Pro",
    "license": "OFL-1.1 (Adobe / Google Fonts)",
    "sources": [
      "https://fonts.google.com/specimen/Source+Sans+3",
      "https://fonts.google.com/specimen/Source+Serif+4",
      "https://fonts.google.com/specimen/Source+Code+Pro"
    ]
  },
  "fidelity": {
    "recommended": {
      "min": 0,
      "max": 20,
      "default": 0
    },
    "bands": [
      {
        "id": "whisper",
        "min": 0,
        "max": 25,
        "description": "Structure hints only: radius, type voice, subtle edge. No ornaments."
      },
      {
        "id": "signature",
        "min": 26,
        "max": 66,
        "description": "Clear era geometry and materials; sparse ornaments on surfaces."
      },
      {
        "id": "costume",
        "min": 67,
        "max": 100,
        "description": "Full decorative program. Demo/showcase territory; neverDo still binds."
      }
    ]
  },
  "modes": [
    "light",
    "dark"
  ],
  "neverDo": [
    "Do not add era ornaments to Neutral.",
    "Do not use display faces on controls.",
    "Do not introduce glow, chrome gradients, or sunburst motifs.",
    "Do not change elevation model via brand overlays."
  ],
  "tokenFiles": [
    "spec/tokens/tier1/neutral.light.tokens.json",
    "spec/tokens/tier1/neutral.dark.tokens.json",
    "spec/tokens/tier2/neutral.shared.tokens.json",
    "spec/tokens/tier3/components.shared.tokens.json"
  ],
  "card": {
    "lines": [
      "era: neutral",
      "voice: quiet system UI",
      "shape: soft rect / modest radius",
      "edge: hairline",
      "surface: flat tonal",
      "elevation: soft shadow",
      "ornament: none",
      "type: Source Sans 3 + Source Serif 4",
      "fidelity: default 0 (0\u201320)",
      "modes: light, dark",
      "use: serious apps, brand host",
      "never: ornaments, glow, costume type"
    ]
  },
  "structure": {
    "controlRadius": "8px",
    "surfaceRadius": "12px",
    "button": {
      "borderWidth": "1px",
      "borderStyle": "solid",
      "letterSpacing": "0",
      "textTransform": "none",
      "fontWeight": "600",
      "shadow": "0 1px 2px color-mix(in oklch, var(--ew-color-fg-default) 12%, transparent)",
      "clipPath": "none",
      "paddingX": "16px",
      "paddingY": "8px"
    },
    "card": {
      "borderWidth": "1px",
      "borderStyle": "solid",
      "shadow": "0 1px 2px color-mix(in oklch, var(--ew-color-fg-default) 8%, transparent)",
      "raisedShadow": "0 4px 12px color-mix(in oklch, var(--ew-color-fg-default) 12%, transparent)",
      "clipPath": "none",
      "padding": "16px",
      "headerRule": false,
      "titleTracking": "0",
      "ornament": "none"
    }
  }
}
