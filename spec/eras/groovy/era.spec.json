{
  "$schema": "../../schema/era.schema.json",
  "id": "groovy",
  "name": "Groovy",
  "aliases": [
    "70s",
    "psychedelic"
  ],
  "identity": {
    "oneLiner": "70s groove: avocado & harvest gold, soft flares, lazy curves.",
    "summary": "Warm seventies palette with flared radii and soft shadow. Motifs are flower/sun arcs, never neon grids.",
    "bestFit": [
      "Music / lifestyle",
      "Food brands",
      "Retro product stories"
    ],
    "authenticityNotes": "Warmth and curve beat paisley overload."
  },
  "axes": {
    "shape": "Flared / superellipse radii",
    "edge": "Soft borders or tonal only",
    "surface": "Warm paper, suede-like",
    "elevation": "Soft lift + occasional long shadow",
    "ornament": "Sun arcs / petal marks sparse",
    "typeVoice": "Rounded display; warm body",
    "motion": "Slow ease, groovy sway (respect reduced motion)",
    "density": "Relaxed",
    "iconography": "Rounded stroke"
  },
  "fonts": {
    "display": "Comfortaa",
    "body": "Mulish",
    "mono": "IBM Plex Mono",
    "license": "OFL-1.1",
    "sources": [
      "https://fonts.google.com/specimen/Comfortaa",
      "https://fonts.google.com/specimen/Mulish",
      "https://fonts.google.com/specimen/IBM+Plex+Mono"
    ]
  },
  "fidelity": {
    "recommended": {
      "min": 67,
      "max": 100,
      "default": 75
    },
    "bands": [
      {
        "id": "whisper",
        "min": 0,
        "max": 25,
        "description": "Structure hints only."
      },
      {
        "id": "signature",
        "min": 26,
        "max": 66,
        "description": "Clear era geometry."
      },
      {
        "id": "costume",
        "min": 67,
        "max": 100,
        "description": "Full decorative program."
      }
    ]
  },
  "modes": [
    "light",
    "dark"
  ],
  "neverDo": [
    "Never mix synthwave neon into Groovy.",
    "Never put Comfortaa on dense form controls.",
    "Never use avocado/gold as the only contrast for small text.",
    "Avoid spinning decorative flowers under reduced motion."
  ],
  "tokenFiles": [
    "spec/tokens/tier1/groovy.light.tokens.json",
    "spec/tokens/tier1/groovy.dark.tokens.json",
    "spec/tokens/tier2/groovy.shared.tokens.json",
    "spec/tokens/tier3/components.shared.tokens.json"
  ],
  "card": {
    "lines": [
      "era: groovy",
      "voice: 70s warm groove",
      "shape: flared radii",
      "edge: soft / tonal",
      "surface: warm paper",
      "elevation: soft lift",
      "ornament: sun/petal sparse",
      "type: Comfortaa + Mulish",
      "fidelity: default 40 (25–60)",
      "modes: light, dark",
      "use: music, food, lifestyle",
      "never: neon grids, display on controls"
    ]
  },
  "structure": {
    "controlRadius": "999px",
    "surfaceRadius": "28px",
    "button": {
      "borderWidth": "0px",
      "borderStyle": "solid",
      "letterSpacing": "0.03em",
      "textTransform": "none",
      "fontWeight": "700",
      "shadow": "0 4px 0 0 color-mix(in oklch, var(--ew-color-fg-default) 15%, transparent)",
      "clipPath": "none",
      "paddingX": "20px",
      "paddingY": "10px"
    },
    "card": {
      "borderWidth": "0px",
      "borderStyle": "solid",
      "shadow": "0 6px 16px color-mix(in oklch, var(--ew-color-fg-default) 12%, transparent)",
      "raisedShadow": "0 10px 24px color-mix(in oklch, var(--ew-color-fg-default) 16%, transparent)",
      "clipPath": "none",
      "padding": "24px",
      "headerRule": false,
      "titleTracking": "0.04em",
      "ornament": "none"
    },
    "field": {
      "borderWidth": "1px",
      "borderStyle": "solid",
      "radius": "999px",
      "underline": false
    },
    "dialog": {
      "borderWidth": "1px",
      "borderStyle": "solid",
      "radius": "28px",
      "shadow": "var(--ew-elevation-dialog)",
      "clipPath": "none"
    },
    "tabs": {
      "indicatorHeight": "2px",
      "indicatorStyle": "solid",
      "radius": "0px",
      "enclosed": false
    },
    "switch": {
      "trackRadius": "999px",
      "thumbRadius": "999px",
      "shadow": "none"
    }
  }
}
