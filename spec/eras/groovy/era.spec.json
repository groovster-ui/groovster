{
  "$schema": "../../schema/era.schema.json",
  "id": "groovy",
  "name": "Groovy",
  "aliases": [
    "70s",
    "psychedelic"
  ],
  "identity": {
    "oneLiner": "Psychedelic poster groove: sunbursts, hot color, thick ink.",
    "summary": "Cream paper or plum night, saturated sun, magenta, tangerine, and violet. Controls are sticker bubbles with a hard second-color offset. Motifs are suns, daisies, and waves, never neon grids or muted avocado chrome.",
    "bestFit": [
      "Music / lifestyle",
      "Food brands",
      "Retro product stories"
    ],
    "authenticityNotes": "Poster flatness, a heavy keyline, and a second-color offset beat soft beige and pill forms."
  },
  "axes": {
    "shape": "Bubble controls, organic cards",
    "edge": "Thick ink keyline",
    "surface": "Cream paper or plum night",
    "elevation": "Hard color offset",
    "ornament": "Sun, daisy, wave",
    "typeVoice": "Poster display; warm body",
    "motion": "Slow ease, groovy sway (respect reduced motion)",
    "density": "Relaxed",
    "iconography": "Rounded stroke"
  },
  "fonts": {
    "display": "Lilita One",
    "body": "Mulish",
    "mono": "IBM Plex Mono",
    "license": "OFL-1.1",
    "sources": [
      "https://fonts.google.com/specimen/Lilita+One",
      "https://fonts.google.com/specimen/Mulish",
      "https://fonts.google.com/specimen/IBM+Plex+Mono"
    ]
  },
  "fidelity": {
    "recommended": {
      "min": 67,
      "max": 100,
      "default": 75
    },
    "bands": [
      {
        "id": "whisper",
        "min": 0,
        "max": 25,
        "description": "Structure hints only."
      },
      {
        "id": "standard",
        "min": 26,
        "max": 66,
        "description": "Clear era geometry. Alias: signature."
      },
      {
        "id": "costume",
        "min": 67,
        "max": 100,
        "description": "Full decorative program. Applied when data-fidelity-band is absent."
      }
    ]
  },
  "modes": [
    "light",
    "dark"
  ],
  "neverDo": [
    "Never mix synthwave neon into Groovy.",
    "Never put Lilita One on dense form controls.",
    "Never use sun, magenta, or avocado as the only contrast for small text.",
    "Avoid spinning decorative flowers under reduced motion."
  ],
  "tokenFiles": [
    "spec/tokens/tier1/groovy.light.tokens.json",
    "spec/tokens/tier1/groovy.dark.tokens.json",
    "spec/tokens/tier2/groovy.light.tokens.json",
    "spec/tokens/tier2/groovy.dark.tokens.json",
    "spec/tokens/tier3/components.shared.tokens.json"
  ],
  "card": {
    "lines": [
      "era: groovy",
      "voice: psychedelic poster",
      "shape: bubble controls, organic cards",
      "edge: thick ink keyline",
      "surface: cream paper or plum night",
      "elevation: hard color offset",
      "ornament: sun, daisy, wave",
      "type: Lilita One + Mulish",
      "fidelity: costume default; bands whisper|standard|costume (default deprecated alias of standard)",
      "modes: light, dark",
      "use: music, food, lifestyle",
      "never: neon grids, display on controls"
    ]
  },
  "structure": {
    "controlRadius": "999px",
    "surfaceRadius": "28px",
    "button": {
      "borderWidth": "3px",
      "borderStyle": "solid",
      "letterSpacing": "0.01em",
      "textTransform": "none",
      "fontWeight": "700",
      "shadow": "4px 4px 0 0 var(--ew-color-magenta)",
      "clipPath": "none",
      "paddingX": "20px",
      "paddingY": "12px"
    },
    "card": {
      "borderWidth": "3px",
      "borderStyle": "solid",
      "shadow": "6px 6px 0 0 var(--ew-color-magenta)",
      "raisedShadow": "7px 7px 0 0 var(--ew-color-tangerine)",
      "clipPath": "none",
      "padding": "24px",
      "headerRule": false,
      "titleTracking": "0.01em",
      "ornament": "none"
    },
    "field": {
      "borderWidth": "3px",
      "borderStyle": "solid",
      "radius": "18px",
      "underline": false
    },
    "dialog": {
      "borderWidth": "3px",
      "borderStyle": "solid",
      "radius": "28px",
      "shadow": "var(--ew-elevation-dialog)",
      "clipPath": "none"
    },
    "tabs": {
      "indicatorHeight": "2px",
      "indicatorStyle": "solid",
      "radius": "0px",
      "enclosed": false
    },
    "switch": {
      "trackRadius": "999px",
      "thumbRadius": "999px",
      "shadow": "none"
    },
    "tooltip": {
      "radius": "16px",
      "shadow": "4px 4px 0 0 var(--ew-color-aqua)",
      "padding": "8px 12px"
    },
    "slider": {
      "trackHeight": "16px",
      "thumbSize": "32px",
      "trackRadius": "999px"
    }
  }
}
