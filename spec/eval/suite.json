{
  "version": 1,
  "name": "groovster-agent-harness-v1",
  "description": "Groovster eval: 33 tasks \u00d7 docs-agent vs mcp-agent. Real tokens/turns from agent I/O; validate + render check.",
  "componentsInScope": [
    "button",
    "card",
    "dialog",
    "text-field",
    "switch",
    "tabs"
  ],
  "erasInScope": [
    "neutral",
    "deco",
    "mcm-atomic",
    "neon"
  ],
  "setups": [
    {
      "id": "docs-agent",
      "label": "Docs/llms agent (no MCP)",
      "mcp": false,
      "notes": "Reads generated llms + era cards; emits canonical HTML."
    },
    {
      "id": "mcp-agent",
      "label": "MCP tool agent",
      "mcp": true,
      "notes": "Calls list_eras/get_era_spec/get_component/validate; real turn+token accounting."
    }
  ],
  "scoring": {
    "dimensions": [
      {
        "id": "validate",
        "weight": 0.5,
        "description": "Spec/heuristic validate pass"
      },
      {
        "id": "structure",
        "weight": 0.2,
        "description": "Required classes/eras/variants present"
      },
      {
        "id": "tokens",
        "weight": 0.15,
        "description": "Estimated prompt+completion tokens (lower better)"
      },
      {
        "id": "turns",
        "weight": 0.15,
        "description": "Agent turns until success (lower better)"
      }
    ],
    "passThreshold": 0.7
  },
  "tasks": [
    "ew-001",
    "ew-002",
