{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://era-widgets.dev/schema/era.schema.json",
  "title": "Era Widgets Era Pack Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "identity",
    "axes",
    "fonts",
    "fidelity",
    "modes",
    "neverDo",
    "tokenFiles",
    "card",
    "structure"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oneLiner",
        "summary",
        "bestFit"
      ],
      "properties": {
        "oneLiner": {
          "type": "string",
          "maxLength": 160
        },
        "summary": {
          "type": "string"
        },
        "bestFit": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "authenticityNotes": {
          "type": "string"
        }
      }
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape",
        "edge",
        "surface",
        "elevation",
        "ornament",
        "typeVoice",
        "motion",
        "density",
        "iconography"
      ],
      "properties": {
        "shape": {
          "type": "string"
        },
        "edge": {
          "type": "string"
        },
        "surface": {
          "type": "string"
        },
        "elevation": {
          "type": "string"
        },
        "ornament": {
          "type": "string"
        },
        "typeVoice": {
          "type": "string"
        },
        "motion": {
          "type": "string"
        },
        "density": {
          "type": "string"
        },
        "iconography": {
          "type": "string"
        }
      }
    },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display",
        "body",
        "mono",
        "license"
      ],
      "properties": {
        "display": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "mono": {
          "type": "string"
        },
        "license": {
          "type": "string",
          "description": "Must be open (OFL, Apache, SIL, etc.)."
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "fidelity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommended",
        "bands"
      ],
      "properties": {
        "recommended": {
          "type": "object",
          "required": [
            "min",
            "max",
            "default"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "default": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "bands": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "min",
              "max",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "min": {
                "type": "integer"
              },
              "max": {
                "type": "integer"
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "dialects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "light",
          "dark"
        ]
      },
      "minItems": 2
    },
    "neverDo": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3
    },
    "tokenFiles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lines"
      ],
      "properties": {
        "lines": {
          "type": "array",
          "minItems": 8,
          "maxItems": 20,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlRadius",
        "surfaceRadius",
        "button",
        "card",
        "field",
        "dialog",
        "tabs",
        "switch",
        "tooltip",
        "slider"
      ],
      "properties": {
        "controlRadius": {
          "type": "string"
        },
        "surfaceRadius": {
          "type": "string"
        },
        "button": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "borderWidth",
            "borderStyle",
            "letterSpacing",
            "textTransform",
            "fontWeight",
            "shadow",
            "clipPath"
          ],
          "properties": {
            "borderWidth": {
              "type": "string"
            },
            "borderStyle": {
              "type": "string"
            },
            "letterSpacing": {
              "type": "string"
            },
            "textTransform": {
              "type": "string"
            },
            "fontWeight": {
              "type": "string"
            },
            "shadow": {
              "type": "string"
            },
            "clipPath": {
              "type": "string"
            },
            "paddingX": {
              "type": "string"
            },
            "paddingY": {
              "type": "string"
            },
            "titleCase": {
              "type": "boolean"
            },
            "bevel": {
              "type": "string",
              "description": "Optional inset highlight for chrome bevels"
            }
          }
        },
        "card": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "borderWidth",
            "borderStyle",
            "shadow",
            "clipPath",
            "padding",
            "headerRule"
          ],
          "properties": {
            "borderWidth": {
              "type": "string"
            },
            "borderStyle": {
              "type": "string"
            },
            "shadow": {
              "type": "string"
            },
            "clipPath": {
              "type": "string"
            },
            "padding": {
              "type": "string"
            },
            "headerRule": {
              "type": "boolean"
            },
            "titleTracking": {
              "type": "string"
            },
            "ornament": {
              "type": "string",
              "enum": [
                "none",
                "chevron",
                "starburst",
                "scanline"
              ]
            },
            "raisedShadow": {
              "type": "string"
            }
          }
        },
        "field": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "borderWidth",
            "borderStyle",
            "radius"
          ],
          "properties": {
            "borderWidth": {
              "type": "string"
            },
            "borderStyle": {
              "type": "string"
            },
            "radius": {
              "type": "string"
            },
            "underline": {
              "type": "boolean"
            }
          }
        },
        "dialog": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "borderWidth",
            "borderStyle",
            "radius",
            "shadow"
          ],
          "properties": {
            "borderWidth": {
              "type": "string"
            },
            "borderStyle": {
              "type": "string"
            },
            "radius": {
              "type": "string"
            },
            "shadow": {
              "type": "string"
            },
            "clipPath": {
              "type": "string"
            }
          }
        },
        "tabs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "indicatorHeight",
            "indicatorStyle",
            "radius"
          ],
          "properties": {
            "indicatorHeight": {
              "type": "string"
            },
            "indicatorStyle": {
              "type": "string"
            },
            "radius": {
              "type": "string"
            },
            "enclosed": {
              "type": "boolean"
            }
          }
        },
        "switch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trackRadius",
            "thumbRadius",
            "shadow"
          ],
          "properties": {
            "trackRadius": {
              "type": "string"
            },
            "thumbRadius": {
              "type": "string"
            },
            "shadow": {
              "type": "string"
            }
          }
        },
        "tooltip": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "radius",
            "shadow",
            "padding"
          ],
          "properties": {
            "radius": {
              "type": "string"
            },
            "shadow": {
              "type": "string"
            },
            "padding": {
              "type": "string"
            }
          }
        },
        "slider": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trackHeight",
            "thumbSize",
            "trackRadius"
          ],
          "properties": {
            "trackHeight": {
              "type": "string"
            },
            "thumbSize": {
              "type": "string"
            },
            "trackRadius": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
