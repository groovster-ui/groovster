{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://era-widgets.dev/schema/recipe.schema.json",
  "title": "Era Widgets website recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "id", "name", "category", "summary", "priority", "keywords", "eras", "fidelity", "sections", "hierarchy", "layouts", "responsive", "components", "typography", "spacing", "interactions", "accessibility", "ornament", "density", "eraDeviations", "customization", "demo"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 3 },
    "category": { "type": "string", "minLength": 3 },
    "summary": { "type": "string", "minLength": 20, "maxLength": 280 },
    "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
    "keywords": { "type": "array", "minItems": 3, "maxItems": 16, "items": { "type": "string", "minLength": 2 } },
    "eras": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended", "alsoFits", "avoid"],
      "properties": {
        "recommended": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "alsoFits": { "type": "array", "items": { "type": "string" } },
        "avoid": { "type": "array", "items": { "type": "string" } }
      }
    },
    "fidelity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "forms", "data", "notes"],
      "properties": {
        "page": { "enum": ["whisper", "standard", "costume"] },
        "forms": { "enum": ["whisper", "standard", "costume"] },
        "data": { "enum": ["whisper", "standard", "costume"] },
        "notes": { "type": "string", "minLength": 8 }
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/section" } },
        "optional": { "type": "array", "items": { "$ref": "#/$defs/section" } }
      }
    },
    "hierarchy": { "type": "array", "minItems": 2, "items": { "type": "string" } },
    "layouts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "responsive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["breakpoint", "behavior"],
      "properties": { "breakpoint": { "type": "string" }, "behavior": { "type": "string" } }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "optional": { "type": "array", "items": { "type": "string" } }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priorities"],
      "properties": { "priorities": { "type": "array", "minItems": 1, "items": { "type": "string" } } }
    },
    "spacing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority"],
      "properties": { "priority": { "type": "string" } }
    },
    "interactions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "accessibility": { "type": "array", "minItems": 2, "items": { "type": "string" } },
    "ornament": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use", "avoid"],
      "properties": {
        "use": { "type": "array", "items": { "type": "string" } },
        "avoid": { "type": "array", "items": { "type": "string" } }
      }
    },
    "density": { "enum": ["immersive", "comfortable", "compact"] },
    "eraDeviations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eras", "note"],
        "properties": {
          "eras": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "note": { "type": "string" }
        }
      }
    },
    "customization": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "demo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "era", "mode", "fidelity"],
      "properties": {
        "path": { "type": "string" },
        "era": { "type": "string" },
        "mode": { "enum": ["light", "dark"] },
        "fidelity": { "enum": ["whisper", "standard", "costume"] }
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "purpose": { "type": "string" }
      }
    }
  }
}
