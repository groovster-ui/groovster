{
  "$schema": "../schema/component.schema.json",
  "id": "text-field",
  "name": "TextField",
  "summary": "Labeled single-line text input. Native <input>; eras skin the chrome only.",
  "className": "ew-text-field",
  "nativeElement": "input",
  "behavior": "native",
  "anatomy": [
    {
      "part": "root",
      "required": true,
      "selector": ".ew-text-field",
      "description": "Wrapper associating label, control, and messages."
    },
    {
      "part": "label",
      "required": true,
      "selector": ".ew-text-field__label",
      "description": "Visible label."
    },
    {
      "part": "control",
      "required": true,
      "selector": ".ew-text-field__control",
      "description": "The <input>."
    },
    {
      "part": "description",
      "required": false,
      "selector": ".ew-text-field__description",
      "description": "Helper text."
    },
    {
      "part": "error",
      "required": false,
      "selector": ".ew-text-field__error",
      "description": "Error message."
    },
    {
      "part": "ornament-before",
      "required": false,
      "selector": "[data-slot=ornament-before]",
      "description": "Leading era ornament."
    },
    {
      "part": "indicator",
      "required": false,
      "selector": "[data-slot=indicator]",
      "description": "Focus/validity indicator chrome."
    }
  ],
  "variants": {
    "variant": {
      "attribute": "data-variant",
      "values": [
        "outline",
        "filled",
        "underline"
      ],
      "default": "outline",
      "description": "Field chrome style."
    }
  },
  "sizes": {
    "attribute": "data-size",
    "values": [
      "sm",
      "md",
      "lg"
    ],
    "default": "md"
  },
  "states": [
    {
      "name": "focus",
      "selector": ":focus-within",
      "description": "Field focused."
    },
    {
      "name": "invalid",
      "selector": "[data-invalid=true], :invalid",
      "description": "Validation failed."
    },
    {
      "name": "disabled",
      "selector": ":disabled, [aria-disabled=true]",
      "description": "Non-editable."
    },
    {
      "name": "readonly",
      "selector": ":read-only",
      "description": "Read-only."
    }
  ],
  "aria": {
    "role": "textbox (native input)",
    "requiredAttributes": [
      "id (input)",
      "for (label) or aria-labelledby"
    ],
    "optionalAttributes": [
      "aria-describedby",
      "aria-invalid",
      "aria-required"
    ],
    "notes": [
      "Wire label via for/id.",
      "Point aria-describedby at description and/or error ids.",
      "On error, set aria-invalid=true and keep the error text in the accessibility tree."
    ]
  },
  "keyboard": [
    {
      "keys": "Tab",
      "action": "Move focus into/out of field"
    },
    {
      "keys": "printable keys",
      "action": "Edit value"
    }
  ],
  "slots": [
    {
      "name": "label",
      "kind": "content",
      "description": "Visible label text."
    },
    {
      "name": "description",
      "kind": "content",
      "description": "Helper copy."
    },
    {
      "name": "error",
      "kind": "content",
      "description": "Error copy."
    },
    {
      "name": "ornament-before",
      "kind": "decorator",
      "cssRenderable": true,
      "description": "Leading ornament."
    },
    {
      "name": "indicator",
      "kind": "decorator",
      "cssRenderable": true,
      "description": "Validity/focus indicator."
    }
  ],
  "canonicalHtml": "<div class=\"ew-text-field\">\n  <label class=\"ew-text-field__label\" for=\"email\">Email</label>\n  <input id=\"email\" class=\"ew-text-field__control\" type=\"email\" autocomplete=\"email\" />\n</div>",
  "imports": [
    "@era-widgets/css/text-field.css",
    "@era-widgets/css/eras/<era>.css"
  ],
  "do": [
    "Always provide a visible label.",
    "Use native input types (email, password, search) when appropriate.",
    "Keep placeholder as hint only \u2014 never as the only label."
  ],
  "dont": [
    "Don't remove focus rings; eras may restyle them, not delete them.",
    "Don't put the only instructions in placeholder text.",
    "Don't use div contenteditable as a text field."
  ],
  "tokenDeps": [
    "color.field.*",
    "color.fg.*",
    "color.border.*",
    "space.field.*",
    "radius.field",
    "type.field",
    "motion.focus"
  ]
}
