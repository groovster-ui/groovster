{
  "$schema": "../schema/component.schema.json",
  "id": "pagination",
  "name": "Pagination",
  "summary": "Previous, next, and page links. The current page uses aria-current.",
  "className": "ew-pagination",
  "nativeElement": "nav (custom element later: ew-pagination)",
  "behavior": "web-component",
  "anatomy": [
    {
      "part": "root",
      "required": true,
      "selector": ".ew-pagination",
      "description": "Root element."
    }
  ],
  "variants": {
    "variant": {
      "attribute": "data-variant",
      "values": [
        "default"
      ],
      "default": "default",
      "description": "Visual."
    }
  },
  "sizes": {
    "attribute": "data-size",
    "values": [
      "sm",
      "md"
    ],
    "default": "md"
  },
  "states": [
    {
      "name": "hover",
      "selector": ":hover",
      "description": "Pointer hover."
    },
    {
      "name": "focus-visible",
      "selector": ":focus-visible",
      "description": "Keyboard focus."
    },
    {
      "name": "disabled",
      "selector": ":disabled, [aria-disabled=true]",
      "description": "Non-interactive."
    },
    {
      "name": "busy",
      "selector": "[aria-busy=true]",
      "description": "Loading."
    },
    {
      "name": "empty",
      "selector": ".is-empty",
      "description": "No content yet."
    }
  ],
  "aria": {
    "role": "navigation",
    "requiredAttributes": [],
    "optionalAttributes": [],
    "notes": [
      "aria-current=page on the current page. data-compact=true shows only the current page plus prev and next."
    ]
  },
  "keyboard": [
    {
      "keys": "Tab",
      "action": "Move between links."
    }
  ],
  "slots": [
    {
      "name": "default",
      "kind": "content",
      "description": "Content."
    }
  ],
  "canonicalHtml": "<nav class=\"ew-pagination\" aria-label=\"Pages\"><a class=\"ew-pagination__prev\" href=\"#p1\">Prev</a><a class=\"ew-pagination__page\" href=\"#p2\" aria-current=\"page\">2</a><a class=\"ew-pagination__next\" href=\"#p3\">Next</a></nav>",
  "imports": [
    "@groovster/css/pagination.css",
    "@groovster/css/eras/<era>.css"
  ],
  "do": [
    "Keep markup era-neutral and set data-era on an ancestor."
  ],
  "dont": [
    "Do not restyle this with a display face or uppercase tracking."
  ],
  "tokenDeps": [
    "color.fg.*",
    "color.bg.*",
    "color.action.*",
    "type.body"
  ]
}
