{
  "$schema": "../schema/component.schema.json",
  "id": "meter",
  "name": "Meter",
  "summary": "Labeled linear meter or progress, plus a small radial.",
  "className": "ew-meter",
  "nativeElement": "div",
  "behavior": "css-only",
  "anatomy": [
    {
      "part": "root",
      "required": true,
      "selector": ".ew-meter",
      "description": "Root element."
    }
  ],
  "variants": {
    "variant": {
      "attribute": "data-variant",
      "values": [
        "linear",
        "radial"
      ],
      "default": "linear",
      "description": "Bar or radial."
    }
  },
  "sizes": {
    "attribute": "data-size",
    "values": [
      "sm",
      "md"
    ],
    "default": "md"
  },
  "states": [
    {
      "name": "hover",
      "selector": ":hover",
      "description": "Pointer hover."
    },
    {
      "name": "focus-visible",
      "selector": ":focus-visible",
      "description": "Keyboard focus."
    },
    {
      "name": "disabled",
      "selector": ":disabled, [aria-disabled=true]",
      "description": "Non-interactive."
    },
    {
      "name": "busy",
      "selector": "[aria-busy=true]",
      "description": "Loading."
    },
    {
      "name": "empty",
      "selector": ".is-empty",
      "description": "No content yet."
    }
  ],
  "aria": {
    "role": "meter",
    "requiredAttributes": [],
    "optionalAttributes": [],
    "notes": [
      "Use meter for a known range and progress for a task. The radial sets --ew-meter-value from 0 to 100."
    ]
  },
  "keyboard": [
    {
      "keys": "none",
      "action": "Not interactive."
    }
  ],
  "slots": [
    {
      "name": "default",
      "kind": "content",
      "description": "Content."
    }
  ],
  "canonicalHtml": "<div class=\"ew-meter\"><span class=\"ew-meter__label\" id=\"m1\">Storage</span><meter class=\"ew-meter__bar\" min=\"0\" max=\"100\" value=\"18\" aria-labelledby=\"m1\">18%</meter></div>",
  "imports": [
    "@groovster/css/meter.css",
    "@groovster/css/eras/<era>.css"
  ],
  "do": [
    "Keep markup era-neutral and set data-era on an ancestor."
  ],
  "dont": [
    "Do not restyle this with a display face or uppercase tracking."
  ],
  "tokenDeps": [
    "color.fg.*",
    "color.bg.*",
    "color.action.*",
    "type.body"
  ]
}
