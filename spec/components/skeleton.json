{
  "$schema": "../schema/component.schema.json",
  "id": "skeleton",
  "name": "Skeleton",
  "summary": "Placeholder while content loads. Still when motion is reduced.",
  "className": "ew-skeleton",
  "nativeElement": "div",
  "behavior": "css-only",
  "anatomy": [
    {
      "part": "root",
      "required": true,
      "selector": ".ew-skeleton",
      "description": "Root element."
    }
  ],
  "variants": {
    "variant": {
      "attribute": "data-variant",
      "values": [
        "line",
        "block"
      ],
      "default": "line",
      "description": "Line or block."
    }
  },
  "sizes": {
    "attribute": "data-size",
    "values": [
      "sm",
      "md"
    ],
    "default": "md"
  },
  "states": [
    {
      "name": "hover",
      "selector": ":hover",
      "description": "Pointer hover."
    },
    {
      "name": "focus-visible",
      "selector": ":focus-visible",
      "description": "Keyboard focus."
    },
    {
      "name": "disabled",
      "selector": ":disabled, [aria-disabled=true]",
      "description": "Non-interactive."
    },
    {
      "name": "busy",
      "selector": "[aria-busy=true]",
      "description": "Loading."
    },
    {
      "name": "empty",
      "selector": ".is-empty",
      "description": "No content yet."
    }
  ],
  "aria": {
    "role": "none",
    "requiredAttributes": [],
    "optionalAttributes": [],
    "notes": [
      "Hide skeletons from assistive tech with aria-hidden and set aria-busy on the region that is loading."
    ]
  },
  "keyboard": [
    {
      "keys": "none",
      "action": "Not interactive."
    }
  ],
  "slots": [
    {
      "name": "default",
      "kind": "content",
      "description": "Content."
    }
  ],
  "canonicalHtml": "<div class=\"ew-skeleton\" data-variant=\"block\" aria-hidden=\"true\"></div>",
  "imports": [
    "@groovster/css/skeleton.css",
    "@groovster/css/eras/<era>.css"
  ],
  "do": [
    "Keep markup era-neutral and set data-era on an ancestor."
  ],
  "dont": [
    "Do not restyle this with a display face or uppercase tracking."
  ],
  "tokenDeps": [
    "color.fg.*",
    "color.bg.*",
    "color.action.*",
    "type.body"
  ]
}
